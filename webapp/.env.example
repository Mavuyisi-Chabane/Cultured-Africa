# Copy this file to .env and fill in your own Paystack TEST (sandbox) keys.
# Get them from: https://dashboard.paystack.com/#/settings/developers (make sure "Test Mode" is on)
# Never commit .env or share your secret key.

PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_CURRENCY=ZAR

# Optional: real SMTP server for sending account-verification and password-reset emails.
# If left blank, those emails are captured locally under db/dev-inbox/ instead of
# being sent, so both flows still work end-to-end during development.
#
# Using Resend (https://resend.com) as the SMTP provider:
#   SMTP_HOST = smtp.resend.com
#   SMTP_PORT = 465        (or 587 — both are supported)
#   SMTP_USER = resend     (this is a fixed literal value, not your account name)
#   SMTP_PASS = <your Resend API key, starts with "re_"> — get it from
#               https://resend.com/api-keys (never commit this)
#
# MAIL_FROM's address must be on a domain verified in your Resend dashboard
# (Domains > Add Domain, then add the SPF/DKIM/DMARC DNS records Resend gives you).
# Until a domain is verified, Resend only lets you send from onboarding@resend.dev
# to the email address your Resend account itself is registered with.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Cultured Africa <no-reply@culturedafrica.co.za>

# Base URL referenced in the verification-code email (https://yourwebsite.com/verify-email,
# where the user enters their email + the 6-digit code) and used to build the password-reset
# link (https://yourwebsite.com/reset-password?token=...). Update this to your real domain
# in production.
APP_BASE_URL=http://localhost:3000

# --- Production-only settings (leave unset for local development) ---

# Set this to "production" when deployed. Enables secure (HTTPS-only) session cookies.
NODE_ENV=

# Signs session cookies. MUST be set to a long random value in production — anyone who
# knows this value can forge a logged-in session. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the real value.
SESSION_SECRET=

# Where the SQLite database file and uploaded videos/images are stored. Leave unset
# locally (defaults to db/cultured-africa.sqlite and public/uploads/). In production,
# point these at a mounted persistent disk — e.g. on Render:
#   DB_PATH=/var/data/cultured-africa.sqlite
#   UPLOADS_DIR=/var/data/uploads
# Without a persistent disk, the database and any uploaded content are wiped on
# every deploy/restart.
DB_PATH=
UPLOADS_DIR=
