{
  "name": "cultured-africa",
  "version": "1.0.0",
  "description": "Cultured Africa streaming platform (SQLite via node:sqlite)",
  "main": "server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "create-admin": "node scripts/create-admin.js",
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/styles.css -o ./public/css/app.css --watch",
    "backup": "node scripts/backup-db.js",
    "test": "node --test --test-concurrency=4 test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.1",
    "puppeteer-core": "^25.8.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
