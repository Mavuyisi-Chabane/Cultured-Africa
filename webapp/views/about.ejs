<!DOCTYPE html>
<html lang="en">
<head>
    <script>
        window.FontAwesomeConfig = {
          autoReplaceSvg: 'nest'
        };
      </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <meta charset="UTF-8">
    <link rel="icon" type="image/png" href="/images/brand/sun.png">
    <link rel="apple-touch-icon" href="/images/brand/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#0f0a08">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Cultured Africa">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () { navigator.serviceWorker.register('/sw.js').catch(function () {}); });
        }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cultured Africa — About</title>
    <link rel="stylesheet" href="/css/app.css?v=<%= cssVersion %>">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400..900&family=EB+Garamond:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'EB Garamond', serif;
            background-color: #140d0a;
            color: #f4ece3;
        }
        .display-font {
            font-family: 'Cinzel', serif;
        }
        .pattern-overlay {
            background-image: url('https://www.transparenttextures.com/patterns/az-subtle.png');
            opacity: 0.05;
        }
    </style>
</head>
<body class="min-h-screen">
    <%- include('partials/header') %>

    <!-- Main Content -->
    <main id="main" class="relative overflow-hidden">
        <div class="absolute inset-0 pattern-overlay pointer-events-none"></div>

        <!-- Hero Section -->
        <section class="max-w-7xl mx-auto px-6 py-20 text-center relative z-10">
            <h1 class="display-font text-5xl md:text-6xl font-bold text-[#f7efe6] mb-4">About Cultured Africa</h1>
            <p class="text-xl md:text-2xl text-[#fcaa13] font-medium mb-6">Preserving Heritage Through Cinematic Storytelling</p>
            <div class="w-32 h-1.5 bg-[#fb6b10] mx-auto rounded-full"></div>
        </section>

        <!-- Mission Statement -->
        <section class="max-w-4xl mx-auto px-6 py-16 text-center relative z-10">
            <h2 class="display-font text-3xl md:text-4xl text-[#f7efe6] italic leading-relaxed mb-8">
                "Educating people about the beauty of our cultural heritage through cinematic storytelling."
            </h2>
            <p class="text-[#a99a8b] text-lg leading-relaxed max-w-2xl mx-auto">
                Cultured Africa is born from a passion to safeguard the rich tapestry of South African traditions, ensuring they are not just remembered, but vibrantly lived and shared across generations.
            </p>
        </section>

        <!-- Who We Are Section -->
        <section class="max-w-7xl mx-auto px-6 py-20 relative z-10">
            <div class="flex flex-col md:flex-row gap-12 items-center">
                <!-- Left Column (40%) -->
                <div class="md:w-[40%]">
                    <div class="rounded-3xl overflow-hidden shadow-2xl">
                        <img class="w-full aspect-[4/5] object-cover object-[50%_70%]" src="/images/crew/cultured-africa-team.jpg" alt="The Cultured Africa team" />
                    </div>
                    <p class="mt-6 italic text-[#a99a8b] text-sm border-l-4 border-[#fcaa13] pl-4">
                        "Capturing the soul of who we are as a people, one story at a time."
                    </p>
                </div>
                <!-- Right Column (60%) -->
                <div class="md:w-[60%] space-y-6">
                    <h2 class="display-font text-4xl font-bold text-[#f7efe6]">Who We Are</h2>
                    <p class="text-[#f7efe6] text-lg leading-relaxed">
                        Cultured Africa is a Johannesburg-based production company dedicated to educating people about the beauty of our cultural heritage through cinematic storytelling. We produce high-quality short films that explore the practices, traditions, and beliefs of South African cultures — capturing the soul of who we are as a people, one story at a time.
                    </p>
                    <p class="text-[#f7efe6] text-lg leading-relaxed">
                        As an emerging filmmaker collective, we represent a new generation of South African creatives committed to reclaiming African narratives and ensuring that our cultural wisdom is preserved for future generations. Our work bridges the gap between traditional knowledge and contemporary audiences, demonstrating that cultural education can be both entertaining and profoundly impactful.
                    </p>
                </div>
            </div>
        </section>

        <!-- Meet the Crew Section -->
        <%
            const crew = [
                { name: 'Lesedi Kgasago', role: 'Executive Producer', photo: 'lesedi-kgasago.jpg' },
                { name: 'Lethabo Lephuthu', role: 'Director & Scriptwriter', photo: 'lethabo-lephuthu.jpg' },
                { name: 'Thato Mazibuko Jnr', role: 'Creative Director', photo: 'thato-mazibuko-jnr.jpg' },
                { name: 'Simphiwe Mabaso', role: 'Cinematographer', photo: 'simphiwe-mabaso.jpg' },
                { name: 'Thendo Muthivhi', role: 'Editor', photo: 'thendo-muthivhi.jpg' },
                { name: 'Thando Mpunguso', role: 'Sound Engineer', photo: 'thando-mpunguso.jpg' },
                { name: 'Thato Mphuti', role: 'Gaffer', photo: 'thato-mphuti.jpg' },
                { name: 'Lindokuhle Zawana', role: 'Key Grip', photo: 'lindokuhle-zawana.jpg' },
                { name: "S'phokazi Mtselu", role: 'Cultural Policy Specialist', photo: 'sphokazi-mtselu.jpg' }
            ];
        %>
        <section id="crew" class="max-w-7xl mx-auto px-6 py-20 relative z-10 scroll-mt-20">
            <div class="text-center mb-16">
                <h2 class="display-font text-4xl font-bold text-[#f7efe6] mb-4">Meet the Crew</h2>
                <p class="text-[#a99a8b] text-lg">The storytellers behind every frame</p>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-6 md:gap-8">
                <% crew.forEach(function (member) { %>
                    <div class="bg-[#1e1613] rounded-2xl shadow-lg border border-[#38281f] overflow-hidden group">
                        <div class="aspect-[4/5] overflow-hidden">
                            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="/images/crew/<%= member.photo %>" alt="<%= member.name %>, <%= member.role %>" loading="lazy" />
                        </div>
                        <div class="p-5 text-center">
                            <h3 class="text-lg md:text-xl font-bold text-[#f7efe6]"><%= member.name %></h3>
                            <p class="text-[10px] md:text-xs font-bold text-[#fcaa13] uppercase tracking-widest mt-1"><%= member.role %></p>
                        </div>
                    </div>
                <% }); %>
            </div>
        </section>

        <!-- Our Films Section -->
        <section class="bg-[#1e1613]/50 py-24 relative z-10">
            <div class="max-w-7xl mx-auto px-6 text-center mb-16">
                <h2 class="display-font text-4xl font-bold text-[#f7efe6] mb-4">Our Films</h2>
                <p class="text-[#a99a8b] text-lg">Exploring the practices, traditions, and beliefs of South African cultures</p>
            </div>
            <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Film 1: Nandi -->
                <div class="bg-[#1e1613] rounded-2xl shadow-lg border border-[#38281f] overflow-hidden group">
                    <div class="h-56 overflow-hidden">
                        <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" src="https://storage.googleapis.com/uxpilot-auth.appspot.com/gen_856bc0ae42_0ce3107f0a33c8b3.png" alt="Zulu cultural imagery, historical film still, traditional Zulu attire" />
                    </div>
                    <div class="p-6">
                        <div class="flex justify-between items-start mb-2">
                            <h3 class="text-xl font-bold text-[#f7efe6]">Nandi</h3>
                            <span class="text-[10px] font-bold text-[#fcaa13] uppercase tracking-widest bg-[#271c17] px-2 py-1 rounded">Completed</span>
                        </div>
                        <p class="text-xs font-bold text-[#fcaa13] uppercase tracking-widest mb-3">Zulu Culture</p>
                        <p class="text-sm text-[#a99a8b] leading-relaxed">
                            A 15-minute short film exploring the beauty and depth of Zulu traditions of courtship.
                        </p>
                    </div>
                </div>

                <!-- Film 2: Yanga -->
                <div class="bg-[#1e1613] rounded-2xl shadow-lg border border-[#38281f] overflow-hidden group">
                    <div class="h-56 overflow-hidden">
                        <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" src="https://storage.googleapis.com/uxpilot-auth.appspot.com/gen_765085bb62_1f09c7a6a597f3e8.png" alt="Xhosa cultural imagery, virginity ceremony tradition, cinematic cultural portrait" />
                    </div>
                    <div class="p-6">
                        <div class="flex justify-between items-start mb-2">
                            <h3 class="text-xl font-bold text-[#f7efe6]">Yanga</h3>
                            <span class="text-[10px] font-bold text-[#9db183] uppercase tracking-widest bg-[#271c17] px-2 py-1 rounded">In Production</span>
                        </div>
                        <p class="text-xs font-bold text-[#fcaa13] uppercase tracking-widest mb-3">Xhosa Culture</p>
                        <p class="text-sm text-[#a99a8b] leading-relaxed">
                            A cinematic portrayal of the Xhosa tradition of Inckiyo (virginity ceremony).
                        </p>
                    </div>
                </div>

                <!-- Film 3: Malome -->
                <div class="bg-[#1e1613] rounded-2xl shadow-lg border border-[#38281f] overflow-hidden group">
                    <div class="h-56 overflow-hidden">
                        <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" src="https://storage.googleapis.com/uxpilot-auth.appspot.com/gen_e51b0c4630_c8dc56182030d922.png" alt="Venda cultural imagery, traditional Venda art and landscape, mystical tone" />
                    </div>
                    <div class="p-6">
                        <div class="flex justify-between items-start mb-2">
                            <h3 class="text-xl font-bold text-[#f7efe6]">Malome</h3>
                            <span class="text-[10px] font-bold text-[#a99a8b] uppercase tracking-widest bg-[#271c17] px-2 py-1 rounded">Planned 2026</span>
                        </div>
                        <p class="text-xs font-bold text-[#fcaa13] uppercase tracking-widest mb-3">Venda Culture</p>
                        <p class="text-sm text-[#a99a8b] leading-relaxed">
                            Exploring the traditions and beliefs of the Venda people.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Why Cultured Africa Matters Section -->
        <section class="max-w-7xl mx-auto px-6 py-24 relative z-10">
            <h2 class="display-font text-4xl font-bold text-[#f7efe6] text-center mb-16">Why Cultured Africa Matters</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
                <!-- Value 1 -->
                <div class="bg-[#1e1613] p-8 rounded-2xl shadow-sm border border-[#38281f] text-center flex flex-col items-center">
                    <div class="w-12 h-12 bg-[#271c17] rounded-full flex items-center justify-center text-[#fcaa13] mb-4">
                        <i class="fa-solid fa-scroll"></i>
                    </div>
                    <h4 class="text-sm font-bold text-[#f7efe6] mb-3">Cultural Preservation</h4>
                    <p class="text-[11px] text-[#a99a8b] leading-relaxed">Documenting traditions before they are lost to time and modernization</p>
                </div>
                <!-- Value 2 -->
                <div class="bg-[#1e1613] p-8 rounded-2xl shadow-sm border border-[#38281f] text-center flex flex-col items-center">
                    <div class="w-12 h-12 bg-[#271c17] rounded-full flex items-center justify-center text-[#fcaa13] mb-4">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>
                    <h4 class="text-sm font-bold text-[#f7efe6] mb-3">Educational Access</h4>
                    <p class="text-[11px] text-[#a99a8b] leading-relaxed">Making cultural knowledge available to all South Africans</p>
                </div>
                <!-- Value 3 -->
                <div class="bg-[#1e1613] p-8 rounded-2xl shadow-sm border border-[#38281f] text-center flex flex-col items-center">
                    <div class="w-12 h-12 bg-[#271c17] rounded-full flex items-center justify-center text-[#fcaa13] mb-4">
                        <i class="fa-solid fa-hands-holding-circle"></i>
                    </div>
                    <h4 class="text-sm font-bold text-[#f7efe6] mb-3">Social Cohesion</h4>
                    <p class="text-[11px] text-[#a99a8b] leading-relaxed">Building understanding between different cultural communities</p>
                </div>
                <!-- Value 4 -->
                <div class="bg-[#1e1613] p-8 rounded-2xl shadow-sm border border-[#38281f] text-center flex flex-col items-center">
                    <div class="w-12 h-12 bg-[#271c17] rounded-full flex items-center justify-center text-[#fcaa13] mb-4">
                        <i class="fa-solid fa-users-rays"></i>
                    </div>
                    <h4 class="text-sm font-bold text-[#f7efe6] mb-3">Youth Engagement</h4>
                    <p class="text-[11px] text-[#a99a8b] leading-relaxed">Inspiring young people to take pride in their heritage</p>
                </div>
                <!-- Value 5 -->
                <div class="bg-[#1e1613] p-8 rounded-2xl shadow-sm border border-[#38281f] text-center flex flex-col items-center">
                    <div class="w-12 h-12 bg-[#271c17] rounded-full flex items-center justify-center text-[#fcaa13] mb-4">
                        <i class="fa-solid fa-award"></i>
                    </div>
                    <h4 class="text-sm font-bold text-[#f7efe6] mb-3">Creative Excellence</h4>
                    <p class="text-[11px] text-[#a99a8b] leading-relaxed">Proving cultural content can meet international standards</p>
                </div>
            </div>
        </section>

        <!-- Get In Touch Section -->
        <section class="max-w-7xl mx-auto px-6 py-24 relative z-10 border-t border-[#38281f]">
            <div class="flex flex-col md:flex-row justify-between gap-12">
                <div class="md:w-1/2">
                    <h2 class="display-font text-4xl font-bold text-[#f7efe6] mb-6">Get In Touch</h2>
                    <div class="space-y-6">
                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 rounded-full bg-[#271c17] flex items-center justify-center text-[#fcaa13] flex-shrink-0">
                                <i class="fa-solid fa-location-dot"></i>
                            </div>
                            <p class="text-[#f7efe6] text-lg">Wits Ehub, The Matrix Shop 3, Wits University, Johannesburg</p>
                        </div>
                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 rounded-full bg-[#271c17] flex items-center justify-center text-[#fcaa13] flex-shrink-0">
                                <i class="fa-solid fa-envelope"></i>
                            </div>
                            <a href="mailto:info@culturedafrica.co.za" class="text-[#f7efe6] text-lg hover:text-[#fcaa13] transition-colors">info@culturedafrica.co.za</a>
                        </div>
                    </div>
                </div>
                <div class="md:w-1/3">
                    <div class="bg-[#1e1613] p-8 rounded-3xl shadow-xl border border-[#38281f] text-center">
                        <img src="/images/crew/lesedi-kgasago.jpg" class="w-24 h-24 rounded-full mx-auto mb-4 border-4 border-[#fcaa13] object-cover object-top" alt="Lesedi Kgasago">
                        <h4 class="text-xl font-bold text-[#f7efe6] mb-1">Lesedi Kgasago</h4>
                        <p class="text-[#a99a8b] text-sm mb-4">Founder & Visionary</p>
                        <a href="mailto:info@culturedafrica.co.za" class="inline-flex items-center gap-2 text-[#fcaa13] font-bold hover:underline">
                            <i class="fa-solid fa-envelope"></i>
                            Get in touch
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer id="footer" class="bg-[#0f0a08] text-[#f4ece3] py-16">
        <div class="max-w-7xl mx-auto px-6 flex flex-col items-center">
            <img src="/images/brand/sun.png" alt="" class="h-16 w-16 mb-3">
            <span class="display-font text-3xl font-bold text-[#fcaa13] mb-6">Cultured Africa</span>
            <p class="text-[#f4ece3]/60 text-sm mb-8">© <%= new Date().getFullYear() %> Cultured Africa. Preserving Heritage Through Cinematic Storytelling.</p>
            <p class="text-[#fcaa13] font-bold tracking-[0.2em] uppercase text-xs">One Film. One Story. One Nation.</p>
            <div class="mt-6 flex flex-wrap justify-center gap-x-5 gap-y-1 text-xs">
                <a href="/help" class="text-[#f4ece3]/60 hover:text-[#fcaa13] underline">Help &amp; FAQ</a>
                <a href="/contact" class="text-[#f4ece3]/60 hover:text-[#fcaa13] underline">Contact</a>
                <a href="/purchase-terms" class="text-[#f4ece3]/60 hover:text-[#fcaa13] underline">Pricing &amp; Refunds</a>
                <a href="/privacy" class="text-[#f4ece3]/60 hover:text-[#fcaa13] underline">Privacy Policy</a>
            </div>
        </div>
    </footer>
</body>
</html>
