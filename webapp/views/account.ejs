<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Cultured Africa — Manage Account' }) %>
<style>
    /* See views/admin-feedback.ejs for why this is needed: the modal below combines
       the native `hidden` attribute with a `flex` display class, which otherwise lets
       `.flex` win the cascade over `[hidden]` and leaves a "closed" modal visible. */
    [hidden] { display: none !important; }
</style>
</head>
<body class="min-h-screen">
<%- include('partials/header') %>

<%
  const initials = user.fullName.trim().split(/\s+/).map(w => w[0]).slice(0, 2).join('').toUpperCase();
%>

<main id="main" class="max-w-3xl mx-auto px-6 py-10 relative">
    <div class="absolute inset-0 pattern-overlay pointer-events-none"></div>

    <div class="mb-8 z-10 relative">
        <h1 class="text-2xl md:text-3xl font-bold text-[#f7efe6] mb-1">Manage Account</h1>
        <p class="text-[#a99a8b] text-sm">Update your name, email address and password, see your receipts, or delete your account.</p>
    </div>

    <% if (success) { %>
        <div class="mb-6 z-10 relative px-4 py-3 rounded-xl bg-[#271c17] text-[#9db183] text-sm font-medium flex items-center gap-2">
            <i class="fa-solid fa-circle-check"></i> <%= success %>
        </div>
    <% } %>
    <% if (error) { %>
        <div class="mb-6 z-10 relative px-4 py-3 rounded-xl bg-[#b62319]/15 text-[#ff7a5c] text-sm font-medium"><%= error %></div>
    <% } %>

    <!-- Profile -->
    <div class="bg-[#1e1613] rounded-[24px] border border-[#38281f] p-8 shadow-sm mb-8 z-10 relative flex items-center gap-5">
        <div class="w-16 h-16 rounded-full bg-[#0f0a08] flex items-center justify-center text-[#fcaa13] text-xl font-bold flex-shrink-0">
            <%= initials %>
        </div>
        <div>
            <p class="text-lg font-bold text-[#f7efe6]"><%= user.fullName %></p>
            <p class="text-[#a99a8b] text-sm"><%= user.email %></p>
        </div>
    </div>

    <!-- Name -->
    <div class="bg-[#1e1613] rounded-[24px] border border-[#38281f] p-8 shadow-sm mb-8 z-10 relative">
        <h2 class="text-sm font-bold uppercase tracking-widest text-[#f7efe6] mb-1">Your Name</h2>
        <p class="text-[#a99a8b] text-sm mb-5">Shown on your account, your receipts and any reviews you write.</p>
        <form method="POST" action="/account/name" class="flex flex-col sm:flex-row sm:items-end gap-4">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="flex-1">
                <label for="fullName" class="block text-[10px] font-bold uppercase tracking-widest text-[#a99a8b] mb-1.5">Full Name</label>
                <input type="text" id="fullName" name="fullName" required minlength="2" maxlength="80" autocomplete="name"
                    value="<%= typeof nameValue !== 'undefined' ? nameValue : user.fullName %>"
                    class="w-full px-4 py-2.5 bg-[#271c17]/50 border border-[#38281f] rounded-xl text-sm focus:border-[#fcaa13] transition-all">
            </div>
            <button type="submit" class="bg-[#0f0a08] hover:bg-[#0a0605] text-[#fcaa13] font-bold px-5 py-2.5 rounded-xl text-sm transition-all border border-[#fcaa13]/30">Save Name</button>
        </form>
    </div>

    <!-- Change Email -->
    <div class="bg-[#1e1613] rounded-[24px] border border-[#38281f] p-8 shadow-sm mb-8 z-10 relative">
        <h2 class="text-sm font-bold uppercase tracking-widest text-[#f7efe6] mb-1">Email Address</h2>

        <% if (pendingEmail) { %>
            <p class="text-[#a99a8b] text-sm mb-5">
                We sent a 6-digit code to <span class="font-bold text-[#f7efe6]"><%= pendingEmail %></span>. Enter it below to confirm the change.
                It expires in <span class="font-bold text-[#f7efe6]">15 minutes</span>.
            </p>
            <form method="POST" action="/account/email/verify" class="flex flex-wrap items-end gap-4 mb-4">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div>
                    <label for="emailCode" class="block text-[10px] font-bold uppercase tracking-widest text-[#a99a8b] mb-1.5">Verification Code</label>
                    <input type="text" id="emailCode" name="code" placeholder="123456" maxlength="6" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" required
                        class="px-4 py-2.5 bg-[#271c17]/50 border border-[#38281f] rounded-xl text-sm focus:border-[#fcaa13] transition-all tracking-[0.3em] font-bold text-center w-40">
                </div>
                <button type="submit" class="bg-[#fb6b10] hover:bg-[#ef420f] text-[#140d0a] font-bold px-5 py-2.5 rounded-xl text-sm transition-all">Confirm Change</button>
            </form>
            <form method="POST" action="/account/email/cancel">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="text-[#a99a8b] hover:text-[#f7efe6] text-xs font-bold uppercase tracking-wider">Cancel this change</button>
            </form>
        <% } else { %>
            <p class="text-[#a99a8b] text-sm mb-5">Changing your email requires your current password, and a code sent to the new address to confirm you own it.</p>
            <form method="POST" action="/account/email" class="space-y-4">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div>
                    <label for="newEmail" class="block text-[10px] font-bold uppercase tracking-widest text-[#a99a8b] mb-1.5">New Email Address</label>
                    <input type="email" id="newEmail" name="newEmail" required placeholder="new-email@example.com"
                        class="w-full px-4 py-2.5 bg-[#271c17]/50 border border-[#38281f] rounded-xl text-sm focus:border-[#fcaa13] transition-all">
                </div>
                <div>
                    <label for="emailChangePassword" class="block text-[10px] font-bold uppercase tracking-widest text-[#a99a8b] mb-1.5">Current Password</label>
                    <input type="password" id="emailChangePassword" name="password" required autocomplete="current-password"
                        class="w-full px-4 py-2.5 bg-[#271c17]/50 border border-[#38281f] rounded-xl text-sm focus:border-[#fcaa13] transition-all">
                </div>
                <button type="submit" class="bg-[#0f0a08] hover:bg-[#0a0605] text-[#fcaa13] font-bold px-5 py-2.5 rounded-xl text-sm transition-all border border-[#fcaa13]/30">Send Verification Code</button>
            </form>
        <% } %>
    </div>

    <!-- Change password -->
    <div class="bg-[#1e1613] rounded-[24px] border border-[#38281f] p-8 shadow-sm mb-8 z-10 relative">
        <h2 class="text-sm font-bold uppercase tracking-widest text-[#f7efe6] mb-1">Password</h2>
        <p class="text-[#a99a8b] text-sm mb-5">Use at least 8 characters with an uppercase letter, a lowercase letter, a number and a special character. Changing it logs you out on your other devices.</p>
        <form method="POST" action="/account/password" class="space-y-4">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% [['currentPassword', 'Current Password', 'current-password'], ['newPassword', 'New Password', 'new-password'], ['confirmPassword', 'Confirm New Password', 'new-password']].forEach(([name, label, ac]) => { %>
                <div>
                    <label for="<%= name %>" class="block text-[10px] font-bold uppercase tracking-widest text-[#a99a8b] mb-1.5"><%= label %></label>
                    <div class="relative">
                        <input type="password" id="<%= name %>" name="<%= name %>" required autocomplete="<%= ac %>" <%= name === 'currentPassword' ? '' : 'minlength=8' %>
                            class="w-full pl-4 pr-11 py-2.5 bg-[#271c17]/50 border border-[#38281f] rounded-xl text-sm focus:border-[#fcaa13] transition-all">
                        <button type="button" class="absolute inset-y-0 right-0 pr-4 flex items-center text-[#a99a8b] hover:text-[#fcaa13]" data-toggle-password="<%= name %>" aria-label="Show password">
                            <i class="fa-solid fa-eye text-sm"></i>
                        </button>
                    </div>
                </div>
            <% }) %>
            <div class="flex flex-wrap items-center gap-4">
                <button type="submit" class="bg-[#0f0a08] hover:bg-[#0a0605] text-[#fcaa13] font-bold px-5 py-2.5 rounded-xl text-sm transition-all border border-[#fcaa13]/30">Change Password</button>
                <span class="text-xs text-[#a99a8b]">Forgotten it? Log out and use “Forgot Password?” on the login page.</span>
            </div>
        </form>
    </div>

    <!-- Purchases & receipts -->
    <div class="bg-[#1e1613] rounded-[24px] border border-[#38281f] p-8 shadow-sm z-10 relative mb-8">
        <h2 class="text-sm font-bold uppercase tracking-widest text-[#f7efe6] mb-1">Purchases &amp; Receipts</h2>
        <% if (purchases.length === 0) { %>
            <p class="text-[#a99a8b] text-sm">You haven't bought any films yet. Receipts for your purchases will appear here.</p>
        <% } else { %>
            <p class="text-[#a99a8b] text-sm mb-4">Proof of purchase for every film you've bought. Open a receipt to print it or save it as a PDF.</p>
            <ul class="divide-y divide-[#38281f]">
                <% purchases.forEach(p => { %>
                    <li class="py-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
                        <div class="min-w-0">
                            <p class="text-sm font-bold text-[#f7efe6]"><%= p.title %></p>
                            <p class="text-xs text-[#a99a8b]"><%= p.dateLabel %> · <%= p.number %></p>
                        </div>
                        <div class="flex items-center gap-4">
                            <span class="text-sm font-bold text-[#f7efe6] tabular-nums"><%= p.totalLabel %></span>
                            <a href="/account/purchases/<%= p.id %>/receipt" class="text-xs font-bold text-[#fcaa13] hover:underline">View receipt</a>
                        </div>
                    </li>
                <% }) %>
            </ul>
        <% } %>
    </div>

    <!-- Newsletter -->
    <div class="bg-[#1e1613] rounded-[24px] border border-[#38281f] p-8 shadow-sm z-10 relative mb-8">
        <h2 class="text-sm font-bold uppercase tracking-widest text-[#f7efe6] mb-1">Newsletter</h2>
        <% if (newsletter.subscribed) { %>
            <p class="text-[#a99a8b] text-sm mb-4">
                You're subscribed to news about new films and releases<% if (newsletter.since) { %> (since <span class="text-[#f7efe6] font-medium"><%= newsletter.since.toLocaleDateString('en-ZA', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>)<% } %>. We send it to <span class="text-[#f7efe6] font-medium"><%= user.email %></span>.
            </p>
            <form method="POST" action="/account/newsletter">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="subscribe" value="no">
                <button type="submit" class="text-sm font-bold text-[#a99a8b] border border-[#38281f] hover:border-[#fcaa13] hover:text-[#f7efe6] px-5 py-2.5 rounded-xl">Unsubscribe</button>
            </form>
        <% } else { %>
            <p class="text-[#a99a8b] text-sm mb-4">Get an email when new films are released. We'll send it to <span class="text-[#f7efe6] font-medium"><%= user.email %></span>, never share your address, and you can unsubscribe at any time.</p>
            <form method="POST" action="/account/newsletter">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="subscribe" value="yes">
                <button type="submit" class="text-sm font-bold bg-[#fb6b10] hover:bg-[#ef420f] text-[#140d0a] px-5 py-2.5 rounded-xl"><i class="fa-solid fa-envelope-open-text mr-1"></i> Subscribe to the newsletter</button>
            </form>
        <% } %>
    </div>

    <!-- Privacy & consent -->
    <div class="bg-[#1e1613] rounded-[24px] border border-[#38281f] p-8 shadow-sm z-10 relative mb-8">
        <h2 class="text-sm font-bold uppercase tracking-widest text-[#f7efe6] mb-1">Privacy &amp; Consent</h2>
        <% if (consentAt) { %>
            <p class="text-[#a99a8b] text-sm mb-3">
                You agreed to our <a href="/privacy" class="text-[#fcaa13] font-bold underline">Privacy Policy</a> on
                <span class="text-[#f7efe6] font-medium"><%= consentAt.toLocaleDateString('en-ZA', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>.
            </p>
        <% } else { %>
            <p class="text-[#a99a8b] text-sm mb-3">You haven't agreed to our <a href="/privacy" class="text-[#fcaa13] font-bold underline">Privacy Policy</a> yet. <a href="/consent" class="text-[#fcaa13] font-bold underline">Review it now</a>.</p>
        <% } %>
        <p class="text-[#a99a8b] text-sm mb-3">
            <% if (adultConfirmedAt) { %>
                You confirmed you are 18 or older on <span class="text-[#f7efe6] font-medium"><%= adultConfirmedAt.toLocaleDateString('en-ZA', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>, so you can watch films rated 18.
            <% } else { %>
                You haven't confirmed your age. You'll be asked to the first time you open a film rated 18.
            <% } %>
        </p>
        <p class="text-[#a99a8b] text-sm">To withdraw your consent, delete your account below. This stops all use of your information and removes it from our systems. For any other privacy request, email <a href="mailto:info@culturedafrica.co.za" class="text-[#fcaa13] underline">info@culturedafrica.co.za</a>.</p>
    </div>

    <!-- Danger zone -->
    <div class="bg-[#1e1613] rounded-[24px] border border-[#b62319]/30 p-8 shadow-sm z-10 relative">
        <h2 class="text-sm font-bold uppercase tracking-widest text-[#ff7a5c] mb-1">Danger Zone</h2>
        <p class="text-[#a99a8b] text-sm mb-5">Deleting your account permanently removes your profile, purchases, watch history, and reviews. This cannot be undone.</p>
        <button type="button" id="delete-account-trigger" class="bg-[#b62319]/15 hover:bg-[#b62319] hover:text-[#f4ece3] text-[#ff7a5c] font-bold px-5 py-2.5 rounded-xl text-sm transition-all border border-[#b62319]/30">
            Delete My Account
        </button>
    </div>

    <%- include('partials/footer') %>
</main>

<!-- Delete account modal -->
<div id="delete-account-modal" hidden role="dialog" aria-modal="true" aria-labelledby="delete-account-title" class="fixed inset-0 bg-black/40 flex items-center justify-center z-[100] px-4">
    <div class="bg-[#1e1613] rounded-2xl shadow-2xl max-w-md w-full p-6">
        <h3 id="delete-account-title" class="text-xl font-bold text-[#f7efe6] mb-2">Delete your account?</h3>
        <p class="text-sm text-[#a99a8b] mb-4">This permanently deletes your account and everything tied to it. Re-enter your password to confirm.</p>
        <form method="POST" action="/account/delete">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label for="deletePassword" class="block text-xs font-bold uppercase tracking-widest text-[#f7efe6] mb-2">Password</label>
            <input type="password" id="deletePassword" name="password" required autocomplete="current-password"
                class="w-full px-4 py-3 bg-[#271c17]/50 border border-[#38281f] rounded-xl focus:border-[#fcaa13] transition-all mb-6">
            <div class="flex items-center justify-end gap-3">
                <button type="button" id="delete-account-cancel" class="text-[#a99a8b] hover:text-[#f7efe6] text-sm font-medium px-4 py-2.5">Cancel</button>
                <button type="submit" class="bg-[#b62319] hover:bg-[#ef420f] text-[#f4ece3] font-bold px-5 py-2.5 rounded-xl text-sm transition-all">Delete My Account</button>
            </div>
        </form>
    </div>
</div>

<script>
(function () {
    const modal = document.getElementById('delete-account-modal');
    const trigger = document.getElementById('delete-account-trigger');
    trigger.addEventListener('click', () => { modal.hidden = false; document.getElementById('deletePassword').focus(); });
    document.getElementById('delete-account-cancel').addEventListener('click', () => { modal.hidden = true; });
    modal.addEventListener('click', e => { if (e.target === modal) modal.hidden = true; });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') modal.hidden = true; });
})();
</script>
<%- include('partials/password-toggle') %>
</body>
</html>
