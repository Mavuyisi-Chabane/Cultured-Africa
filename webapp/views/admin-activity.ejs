<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Cultured Africa — Recent Activity' }) %>
</head>
<body class="min-h-screen">
<% const active = 'activity' %>
<%- include('partials/admin-header', { active }) %>

<main class="max-w-7xl mx-auto px-6 py-10 relative">
    <div class="absolute inset-0 pattern-overlay pointer-events-none"></div>

    <div class="mb-10 z-10 relative">
        <h1 class="display-font text-3xl font-bold text-[#f7efe6]">Recent Activity</h1>
        <p class="text-[#a99a8b] text-sm mt-1">A live log of uploads, purchases, reviews, and account events across the platform.</p>
    </div>

    <div class="bg-[#1e1613] rounded-[24px] shadow-xl shadow-black/[0.03] border border-[#38281f] overflow-hidden z-10 relative">
        <div class="px-8 py-6 border-b border-[#38281f] flex items-center justify-between">
            <h3 class="text-lg font-bold text-[#f7efe6]">All Activity</h3>
            <i class="fa-solid fa-clock-rotate-left text-[#a99a8b]"></i>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-[#271c17]/30">
                        <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-widest text-[#a99a8b]">Activity</th>
                        <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-widest text-[#a99a8b]">Entity</th>
                        <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-widest text-[#a99a8b]">Timestamp</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#38281f]">
                    <% if (recentActivity.length === 0) { %>
                        <tr><td colspan="3" class="px-8 py-5 text-sm text-[#a99a8b]">No activity yet.</td></tr>
                    <% } %>
                    <% recentActivity.forEach(a => { %>
                        <tr class="hover:bg-[#271c17]/20 transition-colors">
                            <td class="px-8 py-5">
                                <span class="text-sm font-medium text-[#f7efe6]"><%= a.type %></span>
                            </td>
                            <td class="px-8 py-5">
                                <span class="text-sm font-bold text-[#f7efe6]"><%= a.entity %></span>
                            </td>
                            <td class="px-8 py-5">
                                <span class="text-xs text-[#a99a8b]"><%= a.timestamp.toLocaleString() %></span>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <footer class="mt-20 py-10 flex flex-col items-center">
        <div class="flex items-center gap-3 opacity-40 mb-4">
            <div class="h-px w-8 bg-[#a99a8b]"></div>
            <span class="text-[10px] uppercase tracking-[0.2em] text-[#a99a8b] font-bold">Cultured Africa Command Centre</span>
            <div class="h-px w-8 bg-[#a99a8b]"></div>
        </div>
        <p class="text-[10px] text-[#a99a8b]/60">© 2026 Cultured Africa Admin Portal. Session active for <%= currentAdmin.name %>.</p>
    </footer>
</main>
</body>
</html>
