<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Cultured Africa — Cultures' }) %>
</head>
<body class="min-h-screen">
<% const active = 'cultures' %>
<%- include('partials/admin-header', { active }) %>
<%
  // After a failed add, `form` holds what was typed (editingId null). After a failed
  // edit, it holds that culture's typed values (editingId set), and its row stays open.
  const addForm = form && !editingId ? form : {};
  const inputCls = 'w-full px-4 py-2.5 bg-[#271c17]/50 border border-[#38281f] rounded-xl text-sm text-[#f7efe6] focus:border-[#fcaa13]';
  const labelCls = 'block text-[11px] font-bold uppercase tracking-widest text-[#a99a8b] mb-1';
%>

<main id="main" class="max-w-5xl mx-auto px-6 py-10 relative">
    <div class="absolute inset-0 pattern-overlay pointer-events-none"></div>

    <div class="mb-8 z-10 relative">
        <h1 class="display-font text-3xl font-bold text-[#f7efe6]">Cultures</h1>
        <p class="text-[#a99a8b] text-sm mt-1">The culture categories films are filed under. Customers use these to filter the catalogue.</p>
    </div>

    <% if (message) { %>
        <div class="mb-6 px-4 py-3 rounded-xl bg-[#271c17] text-[#9db183] text-sm font-medium flex items-center gap-2 z-10 relative" role="status">
            <i class="fa-solid fa-circle-check"></i> <%= message %>
        </div>
    <% } %>
    <% if (error) { %>
        <div class="mb-6 px-4 py-3 rounded-xl bg-[#b62319]/15 text-[#ff7a5c] text-sm font-medium z-10 relative" role="alert"><%= error %></div>
    <% } %>

    <!-- Add a culture -->
    <form method="POST" action="/admin/cultures" class="bg-[#1e1613] rounded-[24px] border border-[#38281f] p-6 mb-8 z-10 relative grid grid-cols-1 md:grid-cols-[1fr_1fr_2fr_auto] gap-4 items-end">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div>
            <label for="new-name" class="<%= labelCls %>">Culture name *</label>
            <input id="new-name" name="name" required maxlength="50" value="<%= addForm.name || '' %>" placeholder="e.g. Pedi" class="<%= inputCls %>">
        </div>
        <div>
            <label for="new-region" class="<%= labelCls %>">Region</label>
            <input id="new-region" name="region" maxlength="80" value="<%= addForm.region || '' %>" placeholder="e.g. Limpopo" class="<%= inputCls %>">
        </div>
        <div>
            <label for="new-description" class="<%= labelCls %>">Short description</label>
            <input id="new-description" name="description" maxlength="300" value="<%= addForm.description || '' %>" placeholder="What stories from this culture explore" class="<%= inputCls %>">
        </div>
        <button type="submit" class="bg-[#fb6b10] hover:bg-[#ef420f] text-[#140d0a] px-5 py-2.5 rounded-xl font-bold text-sm shadow-md transition-all whitespace-nowrap">
            <i class="fa-solid fa-plus mr-1"></i> Add culture
        </button>
    </form>

    <!-- Existing cultures -->
    <div class="bg-[#1e1613] rounded-[24px] border border-[#38281f] overflow-hidden z-10 relative">
        <ul class="divide-y divide-[#38281f]">
            <% if (cultures.length === 0) { %>
                <li class="px-6 py-8 text-sm text-[#a99a8b]">No cultures yet. Add the first one above.</li>
            <% } %>
            <% cultures.forEach(cu => { %>
                <% const isEditing = editingId === cu.id; const v = isEditing ? form : cu; %>
                <li class="px-6 py-5">
                    <div class="flex flex-wrap items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <p class="text-base font-bold text-[#f7efe6]"><%= cu.name %>
                                <span class="ml-2 text-[10px] px-2 py-0.5 rounded font-bold bg-[#271c17] text-[#a99a8b] align-middle"><%= cu.films %> film<%= cu.films === 1 ? '' : 's' %></span>
                            </p>
                            <% if (cu.region) { %><p class="text-xs text-[#fcaa13] mt-0.5"><%= cu.region %></p><% } %>
                            <% if (cu.description) { %><p class="text-sm text-[#a99a8b] mt-1"><%= cu.description %></p><% } %>
                        </div>
                        <div class="flex items-center gap-3">
                            <% if (cu.films === 0) { %>
                                <form action="/admin/cultures/<%= cu.id %>/delete" method="POST" onsubmit="return confirm('Remove the culture <%= cu.name.replace(/['"]/g, '') %>?');">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="text-xs font-bold text-[#ef8a80] hover:underline"><i class="fa-solid fa-trash mr-1"></i>Remove</button>
                                </form>
                            <% } else { %>
                                <span class="text-xs text-[#a99a8b]" title="Move its films to another culture before removing it"><i class="fa-solid fa-lock mr-1"></i>In use</span>
                            <% } %>
                        </div>
                    </div>
                    <details class="mt-3" <%= isEditing ? 'open' : '' %>>
                        <summary class="cursor-pointer text-xs font-bold text-[#fcaa13] hover:underline w-max"><i class="fa-solid fa-pen mr-1"></i>Edit</summary>
                        <form action="/admin/cultures/<%= cu.id %>/edit" method="POST" class="mt-3 grid grid-cols-1 md:grid-cols-[1fr_1fr_2fr_auto] gap-4 items-end">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div>
                                <label for="name-<%= cu.id %>" class="<%= labelCls %>">Name *</label>
                                <input id="name-<%= cu.id %>" name="name" required maxlength="50" value="<%= v.name %>" class="<%= inputCls %>">
                            </div>
                            <div>
                                <label for="region-<%= cu.id %>" class="<%= labelCls %>">Region</label>
                                <input id="region-<%= cu.id %>" name="region" maxlength="80" value="<%= v.region || '' %>" class="<%= inputCls %>">
                            </div>
                            <div>
                                <label for="description-<%= cu.id %>" class="<%= labelCls %>">Short description</label>
                                <input id="description-<%= cu.id %>" name="description" maxlength="300" value="<%= v.description || '' %>" class="<%= inputCls %>">
                            </div>
                            <button type="submit" class="bg-[#0f0a08] text-[#fcaa13] border border-[#fcaa13]/40 hover:border-[#fcaa13] px-5 py-2.5 rounded-xl font-bold text-sm whitespace-nowrap">Save</button>
                        </form>
                        <% if (cu.films > 0) { %>
                            <p class="text-[11px] text-[#a99a8b] mt-2">Renaming updates all <%= cu.films %> film<%= cu.films === 1 ? '' : 's' %> in this culture automatically.</p>
                        <% } %>
                    </details>
                </li>
            <% }) %>
        </ul>
    </div>

    <footer class="mt-20 py-10 flex flex-col items-center">
        <span class="text-[10px] uppercase tracking-[0.2em] text-[#a99a8b] font-bold">Cultured Africa Admin Portal</span>
        <p class="text-[10px] text-[#a99a8b]/60 mt-2">© 2026 Cultured Africa. All rights reserved.</p>
    </footer>
</main>
</body>
</html>
