<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Cultured Africa — Customers' }) %>
</head>
<body class="min-h-screen">
<% const active = 'customers' %>
<%- include('partials/admin-header', { active }) %>
<%
  const fmtDate = d => d ? d.toLocaleDateString('en-ZA', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';
  const returnQuery = new URLSearchParams({ ...(filters.q ? { q: filters.q } : {}), ...(filters.status !== 'all' ? { status: filters.status } : {}) }).toString();
%>

<main class="max-w-7xl mx-auto px-6 py-10 relative">
    <div class="absolute inset-0 pattern-overlay pointer-events-none"></div>

    <div class="mb-8 z-10 relative">
        <h1 class="display-font text-3xl font-bold text-[#f7efe6]">Customers</h1>
        <p class="text-[#a99a8b] text-sm mt-1">
            <%= totals.total %> customer account<%= totals.total === 1 ? '' : 's' %>
            · <%= totals.suspended || 0 %> suspended · <%= totals.unverified || 0 %> not yet verified
        </p>
    </div>

    <% if (message) { %>
        <div class="mb-6 px-4 py-3 rounded-xl bg-[#271c17] text-[#9db183] text-sm font-medium flex items-center gap-2 z-10 relative" role="status">
            <i class="fa-solid fa-circle-check"></i> <%= message %>
        </div>
    <% } %>

    <form method="get" action="/admin/customers" role="search" class="mb-6 flex flex-col md:flex-row gap-3 md:items-center z-10 relative">
        <div class="relative flex-1">
            <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-[#a99a8b] text-sm pointer-events-none"></i>
            <label for="customer-search" class="sr-only">Search customers</label>
            <input id="customer-search" type="search" name="q" value="<%= filters.q %>" maxlength="100" placeholder="Search by name or email…"
                class="w-full pl-11 pr-4 py-3 bg-[#1e1613] border border-[#38281f] rounded-full text-sm text-[#f7efe6] placeholder-[#a99a8b]/70 focus:border-[#fcaa13]">
        </div>
        <label for="customer-status" class="sr-only">Status</label>
        <select id="customer-status" name="status" class="bg-[#1e1613] border border-[#38281f] rounded-full px-4 py-2.5 text-sm font-bold text-[#f7efe6] cursor-pointer focus:border-[#fcaa13]">
            <% statusOptions.forEach(o => { %>
                <option value="<%= o.value %>" <%= filters.status === o.value ? 'selected' : '' %>><%= o.label %></option>
            <% }) %>
        </select>
        <button type="submit" class="bg-[#fb6b10] hover:bg-[#ef420f] text-[#f4ece3] px-6 py-2.5 rounded-full font-bold text-sm shadow-md transition-all">Search</button>
        <% if (filters.q || filters.status !== 'all') { %>
            <a href="/admin/customers" class="text-[#fcaa13] text-sm font-bold hover:underline">Clear</a>
        <% } %>
    </form>

    <div class="bg-[#1e1613] rounded-[24px] shadow-xl shadow-black/[0.03] border border-[#38281f] overflow-hidden z-10 relative">
        <div class="overflow-x-auto">
            <table class="w-full text-left min-w-[900px]">
                <thead>
                    <tr class="bg-[#271c17]/30">
                        <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-[#a99a8b]">Customer</th>
                        <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-[#a99a8b]">Joined</th>
                        <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-[#a99a8b] text-right">Purchases</th>
                        <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-[#a99a8b] text-right">Spent</th>
                        <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-[#a99a8b]">Last watched</th>
                        <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-[#a99a8b]">Status</th>
                        <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-[#a99a8b]">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#38281f]">
                    <% if (customers.length === 0) { %>
                        <tr><td colspan="7" class="px-6 py-8 text-sm text-[#a99a8b]"><%= filters.q || filters.status !== 'all' ? 'No customers match your search.' : 'No customers have registered yet.' %></td></tr>
                    <% } %>
                    <% customers.forEach(c => { %>
                        <tr class="hover:bg-[#271c17]/20 transition-colors align-top">
                            <td class="px-6 py-4">
                                <p class="text-sm font-bold text-[#f7efe6]"><%= c.name %></p>
                                <p class="text-xs text-[#a99a8b] break-all"><%= c.email %></p>
                            </td>
                            <td class="px-6 py-4 text-sm text-[#f7efe6] whitespace-nowrap"><%= fmtDate(c.joined) %></td>
                            <td class="px-6 py-4 text-sm text-[#f7efe6] text-right tabular-nums"><%= c.purchases %></td>
                            <td class="px-6 py-4 text-sm text-[#f7efe6] text-right tabular-nums whitespace-nowrap">R<%= Number(c.spent).toFixed(2) %></td>
                            <td class="px-6 py-4 text-sm text-[#a99a8b] whitespace-nowrap"><%= fmtDate(c.lastWatched) %></td>
                            <td class="px-6 py-4">
                                <% if (c.status === 'suspended') { %>
                                    <span class="text-[10px] px-2 py-1 rounded font-bold bg-[#b62319]/20 text-[#ef8a80]">SUSPENDED</span>
                                    <p class="text-[11px] text-[#a99a8b] mt-1">Since <%= fmtDate(c.suspendedAt) %></p>
                                    <% if (c.suspensionReason) { %><p class="text-[11px] text-[#a99a8b] mt-1 max-w-[220px]">Reason: <%= c.suspensionReason %></p><% } %>
                                <% } else if (!c.verified) { %>
                                    <span class="text-[10px] px-2 py-1 rounded font-bold bg-[#271c17] text-[#fcaa13]">NOT VERIFIED</span>
                                <% } else { %>
                                    <span class="text-[10px] px-2 py-1 rounded font-bold bg-[#271c17] text-[#9db183]">ACTIVE</span>
                                <% } %>
                            </td>
                            <td class="px-6 py-4">
                                <% if (c.status === 'suspended') { %>
                                    <form action="/admin/customers/<%= c.id %>/reactivate" method="POST">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="returnQuery" value="<%= returnQuery %>">
                                        <button type="submit" class="text-xs font-bold text-[#9db183] border border-[#9db183]/40 hover:bg-[#9db183]/10 px-3 py-2 rounded-lg">
                                            <i class="fa-solid fa-rotate-left mr-1"></i> Reactivate
                                        </button>
                                    </form>
                                <% } else { %>
                                    <details class="group">
                                        <summary class="list-none cursor-pointer text-xs font-bold text-[#ef8a80] border border-[#b62319]/40 hover:bg-[#b62319]/10 px-3 py-2 rounded-lg inline-flex items-center gap-1">
                                            <i class="fa-solid fa-ban"></i> Suspend
                                        </summary>
                                        <form action="/admin/customers/<%= c.id %>/suspend" method="POST" class="mt-3 w-64 space-y-2"
                                            onsubmit="return confirm('Suspend <%= c.name.replace(/[\\'"]/g, '') %>? They will be logged out and unable to log in until reactivated.');">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" name="returnQuery" value="<%= returnQuery %>">
                                            <label for="reason-<%= c.id %>" class="block text-[11px] font-bold uppercase tracking-widest text-[#a99a8b]">Reason (optional, admins only)</label>
                                            <textarea id="reason-<%= c.id %>" name="reason" rows="2" maxlength="300"
                                                class="w-full px-3 py-2 bg-[#271c17]/50 border border-[#38281f] rounded-lg text-xs text-[#f7efe6] focus:border-[#fcaa13]"></textarea>
                                            <button type="submit" class="w-full bg-[#b62319] hover:bg-[#ef420f] text-[#f4ece3] font-bold px-3 py-2 rounded-lg text-xs">Suspend account</button>
                                        </form>
                                    </details>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <p class="text-xs text-[#a99a8b] mt-4 z-10 relative">Suspending logs the customer out everywhere straight away. Their purchases and history are kept, and reactivating restores full access.</p>

    <footer class="mt-20 py-10 flex flex-col items-center">
        <span class="text-[10px] uppercase tracking-[0.2em] text-[#a99a8b] font-bold">Cultured Africa Admin Portal</span>
        <p class="text-[10px] text-[#a99a8b]/60 mt-2">© 2026 Cultured Africa. All rights reserved.</p>
    </footer>
</main>
</body>
</html>
