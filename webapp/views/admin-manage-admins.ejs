<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Cultured Africa — Manage Admins' }) %>
<style>
    /* See views/admin-feedback.ejs for why this is needed: the modals below combine
       the native `hidden` attribute with a `flex` display class, which otherwise lets
       `.flex` win the cascade over `[hidden]` and leaves a "closed" modal visible. */
    [hidden] { display: none !important; }
</style>
</head>
<body class="min-h-screen">
<% const active = 'manage-admins' %>
<%- include('partials/admin-header', { active }) %>

<%
  const TOAST_MESSAGES = {
    'invited': 'Invite sent.',
    'invite-resent': 'A new invite code has been sent.',
    'invite-cancelled': 'Invite cancelled.',
    'deactivated': 'Admin deactivated.',
    'reactivated': 'Admin reactivated.',
    'role-updated': 'Role updated.'
  };
%>

<main class="max-w-6xl mx-auto px-6 py-10 relative">
    <div class="absolute inset-0 pattern-overlay pointer-events-none"></div>

    <div class="mb-8 z-10 relative">
        <h1 class="display-font text-3xl font-bold text-[#f7efe6]">Manage Admins</h1>
        <p class="text-[#a99a8b] text-sm mt-1">Invite new admins, and manage roles and access.</p>
    </div>

    <% if (toast && TOAST_MESSAGES[toast]) { %>
        <div class="mb-6 z-10 relative px-4 py-3 rounded-xl bg-[#271c17] text-[#9db183] text-sm font-medium flex items-center gap-2">
            <i class="fa-solid fa-circle-check"></i> <%= TOAST_MESSAGES[toast] %>
        </div>
    <% } %>
    <% if (error) { %>
        <div class="mb-6 z-10 relative px-4 py-3 rounded-xl bg-[#b62319]/15 text-[#ef420f] text-sm font-medium"><%= error %></div>
    <% } %>

    <!-- Send Invite -->
    <div class="bg-[#1e1613] rounded-2xl border border-[#38281f] p-6 shadow-sm mb-8 z-10 relative">
        <h2 class="text-sm font-bold uppercase tracking-widest text-[#f7efe6] mb-4">Invite a New Admin</h2>
        <form method="POST" action="/admin/manage-admins/invite" class="flex flex-wrap items-end gap-4">
            <div class="flex-1 min-w-[200px]">
                <label class="block text-[10px] font-bold uppercase tracking-widest text-[#a99a8b] mb-1.5">Name</label>
                <input type="text" name="name" required placeholder="Full name"
                    class="w-full px-4 py-2.5 bg-[#271c17]/50 border border-[#38281f] rounded-xl text-sm focus:border-[#fcaa13] transition-all">
            </div>
            <div class="flex-1 min-w-[220px]">
                <label class="block text-[10px] font-bold uppercase tracking-widest text-[#a99a8b] mb-1.5">Email</label>
                <input type="email" name="email" required placeholder="name@culturedafrica.co.za"
                    class="w-full px-4 py-2.5 bg-[#271c17]/50 border border-[#38281f] rounded-xl text-sm focus:border-[#fcaa13] transition-all">
            </div>
            <button type="submit" class="bg-[#0f0a08] hover:bg-[#0a0605] text-[#fcaa13] font-bold px-5 py-2.5 rounded-xl text-sm transition-all border border-[#fcaa13]/30 flex items-center gap-2">
                <i class="fa-solid fa-paper-plane"></i> Send Invite
            </button>
        </form>
    </div>

    <!-- Admins table -->
    <div class="bg-[#1e1613] rounded-[24px] shadow-xl shadow-black/[0.03] border border-[#38281f] overflow-hidden z-10 relative">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-[#271c17]/30">
                        <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-widest text-[#a99a8b]">Admin ID</th>
                        <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-widest text-[#a99a8b]">Name</th>
                        <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-widest text-[#a99a8b]">Email</th>
                        <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-widest text-[#a99a8b]">Role</th>
                        <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-widest text-[#a99a8b]">Status</th>
                        <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-widest text-[#a99a8b]">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#38281f]">
                    <% admins.forEach(a => { %>
                        <tr class="hover:bg-[#271c17]/20 transition-colors">
                            <td class="px-8 py-5"><span class="text-xs font-mono text-[#a99a8b]"><%= a.id %></span></td>
                            <td class="px-8 py-5">
                                <span class="text-sm font-bold text-[#f7efe6]"><%= a.name %></span>
                                <% if (a.isSelf) { %><span class="text-[9px] text-[#a99a8b] uppercase font-bold ml-1">(you)</span><% } %>
                            </td>
                            <td class="px-8 py-5"><span class="text-sm text-[#f7efe6]"><%= a.email %></span></td>
                            <td class="px-8 py-5">
                                <span class="text-[10px] px-1.5 py-0.5 rounded font-bold <%= a.role === 'super_admin' ? 'bg-[#271c17] text-[#fcaa13]' : 'bg-[#271c17] text-[#9db183]' %>">
                                    <%= a.role === 'super_admin' ? 'SUPER ADMIN' : 'ADMIN' %>
                                </span>
                            </td>
                            <td class="px-8 py-5">
                                <% if (a.pending) { %>
                                    <span class="text-[10px] px-1.5 py-0.5 rounded font-bold bg-[#fcaa13]/15 text-[#fcaa13]">
                                        PENDING<% if (a.invite && a.invite.status === 'expired') { %> (EXPIRED)<% } %>
                                    </span>
                                <% } else { %>
                                    <span class="text-[10px] px-1.5 py-0.5 rounded font-bold <%= a.status === 'active' ? 'bg-[#271c17] text-[#9db183]' : 'bg-[#271c17] text-[#a99a8b]' %>">
                                        <%= a.status === 'active' ? 'ACTIVE' : 'INACTIVE' %>
                                    </span>
                                <% } %>
                            </td>
                            <td class="px-8 py-5">
                                <div class="flex items-center gap-3">
                                    <% if (a.pending && a.invite) { %>
                                        <form action="/admin/manage-admins/invites/<%= a.invite.id %>/resend" method="POST">
                                            <button type="submit" class="text-[#a99a8b] hover:text-[#fcaa13] text-xs font-bold uppercase tracking-wider">Resend Invite</button>
                                        </form>
                                        <form action="/admin/manage-admins/<%= a.id %>/cancel-invite" method="POST"
                                            onsubmit="return confirm('Cancel this invite for &quot;<%= a.name %>&quot;? They will no longer be able to accept it, and their reserved admin ID (<%= a.id %>) will be freed up.');">
                                            <button type="submit" class="text-[#a99a8b] hover:text-[#ef420f] text-xs font-bold uppercase tracking-wider">Cancel Invite</button>
                                        </form>
                                    <% } else if (!a.pending && !a.isSelf) { %>
                                        <button type="button" class="role-trigger-btn text-[#a99a8b] hover:text-[#fcaa13] text-xs font-bold uppercase tracking-wider"
                                            data-admin-id="<%= a.id %>" data-admin-name="<%= a.name %>"
                                            data-current-role="<%= a.role %>" data-new-role="<%= a.role === 'super_admin' ? 'admin' : 'super_admin' %>">
                                            <%= a.role === 'super_admin' ? 'Demote' : 'Promote' %>
                                        </button>
                                        <% if (a.status === 'active') { %>
                                            <button type="button" class="status-trigger-btn text-[#a99a8b] hover:text-[#ef420f] text-xs font-bold uppercase tracking-wider"
                                                data-admin-id="<%= a.id %>" data-admin-name="<%= a.name %>" data-action="deactivate">
                                                Deactivate
                                            </button>
                                        <% } else { %>
                                            <button type="button" class="status-trigger-btn text-[#a99a8b] hover:text-[#fcaa13] text-xs font-bold uppercase tracking-wider"
                                                data-admin-id="<%= a.id %>" data-admin-name="<%= a.name %>" data-action="reactivate">
                                                Reactivate
                                            </button>
                                        <% } %>
                                    <% } else { %>
                                        <span class="text-[#a99a8b]/50 text-xs italic">—</span>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <footer class="mt-20 py-10 flex flex-col items-center">
        <span class="text-[10px] uppercase tracking-[0.2em] text-[#a99a8b] font-bold">Cultured Africa Admin Portal</span>
        <p class="text-[10px] text-[#a99a8b]/60 mt-2">© 2026 Cultured Africa. All rights reserved.</p>
    </footer>
</main>

<!-- Re-auth modal shared by Deactivate/Reactivate and Promote/Demote — both are
     high-impact actions that require the acting super admin to re-enter their own
     password before anything changes. -->
<div id="reauth-modal" hidden class="fixed inset-0 bg-black/40 flex items-center justify-center z-[100] px-4">
    <div class="bg-[#1e1613] rounded-2xl shadow-2xl max-w-md w-full p-6">
        <h3 id="reauth-title" class="display-font text-xl font-bold text-[#f7efe6] mb-2">Confirm this action</h3>
        <p id="reauth-description" class="text-sm text-[#a99a8b] mb-4"></p>
        <form id="reauth-form" method="POST">
            <input type="hidden" name="role" id="reauth-role-input">
            <label class="block text-xs font-bold uppercase tracking-widest text-[#f7efe6] mb-2">Re-enter your password to confirm this action</label>
            <input type="password" name="password" required autocomplete="current-password"
                class="w-full px-4 py-3 bg-[#271c17]/50 border border-[#38281f] rounded-xl focus:border-[#fcaa13] transition-all mb-6">
            <div class="flex items-center justify-end gap-3">
                <button type="button" id="reauth-cancel" class="text-[#a99a8b] hover:text-[#f7efe6] text-sm font-medium px-4 py-2.5">Cancel</button>
                <button type="submit" id="reauth-submit" class="bg-[#b62319] hover:bg-[#ef420f] text-[#f4ece3] font-bold px-5 py-2.5 rounded-xl text-sm transition-all">Confirm</button>
            </div>
        </form>
    </div>
</div>

<script>
(function () {
    const modal = document.getElementById('reauth-modal');
    const title = document.getElementById('reauth-title');
    const description = document.getElementById('reauth-description');
    const form = document.getElementById('reauth-form');
    const roleInput = document.getElementById('reauth-role-input');

    function openModal(action, adminName) {
        title.textContent = action.title;
        description.textContent = action.description(adminName);
        form.setAttribute('action', action.formAction);
        roleInput.value = action.role || '';
        modal.hidden = false;
    }

    document.querySelectorAll('.status-trigger-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            const isDeactivate = btn.dataset.action === 'deactivate';
            openModal({
                title: isDeactivate ? 'Deactivate this admin?' : 'Reactivate this admin?',
                description: name => isDeactivate
                    ? `${name} will immediately lose admin access.`
                    : `${name} will regain admin access.`,
                formAction: `/admin/manage-admins/${btn.dataset.adminId}/${btn.dataset.action}`
            }, btn.dataset.adminName);
        });
    });

    document.querySelectorAll('.role-trigger-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            const promoting = btn.dataset.newRole === 'super_admin';
            openModal({
                title: promoting ? 'Promote to Super Admin?' : 'Demote to Admin?',
                description: name => promoting
                    ? `${name} will gain full super admin access, including managing other admins.`
                    : `${name} will lose super admin access.`,
                formAction: `/admin/manage-admins/${btn.dataset.adminId}/role`,
                role: btn.dataset.newRole
            }, btn.dataset.adminName);
        });
    });

    document.getElementById('reauth-cancel').addEventListener('click', () => { modal.hidden = true; });
    modal.addEventListener('click', e => { if (e.target === modal) modal.hidden = true; });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') modal.hidden = true; });
})();
</script>
</body>
</html>
