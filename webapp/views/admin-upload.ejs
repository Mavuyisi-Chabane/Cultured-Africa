<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: editing ? 'Cultured Africa — Edit Film' : 'Cultured Africa — Admin Upload' }) %>
</head>
<body class="min-h-screen">
<% const active = 'films' %>
<%- include('partials/admin-header', { active }) %>

<main class="max-w-7xl mx-auto px-6 py-12 relative">
    <div class="absolute inset-0 pattern-overlay pointer-events-none"></div>

    <div class="flex flex-col items-center">
        <div id="upload-card" class="w-full max-w-[700px] bg-white rounded-[24px] shadow-xl shadow-black/5 p-8 md:p-12 z-10">
            <div class="flex items-center justify-between mb-8">
                <h1 class="display-font text-2xl md:text-3xl font-bold text-[#1a1a2e]"><%= editing && editing.id ? 'Edit Film' : 'Upload New Film' %></h1>
                <div class="bg-[#f5f0e8] p-3 rounded-full">
                    <i class="fa-solid fa-cloud-arrow-up text-[#c9a84c] text-xl"></i>
                </div>
            </div>

            <% if (success) { %>
                <div class="mb-6 px-4 py-3 rounded-xl bg-[#e8f5f5] text-[#2d6b6b] text-sm font-medium flex items-center gap-2">
                    <i class="fa-solid fa-circle-check"></i> Film uploaded successfully! It's now live in the catalogue.
                </div>
            <% } %>

            <% if (error) { %>
                <div class="mb-6 px-4 py-3 rounded-xl bg-red-50 text-red-600 text-sm font-medium"><%= error %></div>
            <% } %>

            <form class="space-y-6" method="POST" enctype="multipart/form-data" action="<%= editing && editing.id ? '/admin/films/' + editing.id + '/edit' : '/admin/upload' %>">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold uppercase tracking-widest text-[#2d2d2d] mb-2">Film Title <span class="text-[#c9a84c]">*</span></label>
                        <input type="text" name="title" placeholder="Enter film name" value="<%= editing ? editing.title || '' : '' %>" required
                            class="w-full px-4 py-3 bg-[#f5f0e8]/50 border border-[#e8e0d5] rounded-xl focus:border-[#c9a84c] transition-all">
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold uppercase tracking-widest text-[#2d2d2d] mb-2">Description <span class="text-[#c9a84c]">*</span></label>
                        <textarea name="description" rows="4" placeholder="Describe the film and its cultural significance..." required
                            class="w-full px-4 py-3 bg-[#f5f0e8]/50 border border-[#e8e0d5] rounded-xl focus:border-[#c9a84c] transition-all resize-none"><%= editing ? editing.description || '' : '' %></textarea>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-widest text-[#2d2d2d] mb-2">Culture Category <span class="text-[#c9a84c]">*</span></label>
                        <select name="culture" class="w-full px-4 py-3 bg-[#f5f0e8]/50 border border-[#e8e0d5] rounded-xl focus:border-[#c9a84c] transition-all appearance-none cursor-pointer">
                            <% cultures.forEach(c => { %>
                                <option value="<%= c %>" <%= editing && editing.culture === c ? 'selected' : '' %>><%= c %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-widest text-[#2d2d2d] mb-2">Price (ZAR) <span class="text-[#c9a84c]">*</span></label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-[#8a7f73] font-bold">R</span>
                            <input type="number" step="0.01" name="price" value="<%= editing ? (editing.price || 50) : 50 %>"
                                class="w-full pl-8 pr-4 py-3 bg-[#f5f0e8]/50 border border-[#e8e0d5] rounded-xl focus:border-[#c9a84c] transition-all">
                        </div>
                    </div>

                    <div class="md:col-span-2 flex items-center gap-3 py-2">
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" name="isFree" value="true" class="sr-only peer" <%= editing && editing.price === 0 ? 'checked' : '' %>>
                            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#c9a84c]"></div>
                        </label>
                        <span class="text-sm font-medium text-[#2d2d2d]">This film is free</span>
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold uppercase tracking-widest text-[#2d2d2d] mb-2">
                            Video File <% if (!(editing && editing.videoUrl)) { %><span class="text-[#c9a84c]">*</span><% } %>
                        </label>
                        <input type="file" name="videoFile" accept="video/*" <%= (editing && editing.videoUrl) ? '' : 'required' %>
                            class="w-full px-4 py-3 bg-[#f5f0e8]/50 border border-[#e8e0d5] rounded-xl focus:border-[#c9a84c] transition-all text-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-bold file:uppercase file:tracking-wider file:bg-[#c9a84c] file:text-white hover:file:bg-[#b8973d] file:cursor-pointer cursor-pointer">
                        <p class="text-[11px] text-[#8a7f73] mt-2">Supported formats: MP4, MOV, WebM, AVI, MKV</p>
                        <% if (editing && editing.videoUrl) { %>
                            <p class="text-[11px] text-[#8a7f73] mt-2">Current file: <span class="font-medium"><%= editing.videoUrl.split('/').pop() %></span> — choose a new file to replace it.</p>
                        <% } %>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-widest text-[#2d2d2d] mb-2">
                            Thumbnail Image <% if (!(editing && editing.thumbnailUrl)) { %><span class="text-[#c9a84c]">*</span><% } %>
                        </label>
                        <input type="file" name="thumbnailFile" accept="image/*" <%= (editing && editing.thumbnailUrl) ? '' : 'required' %>
                            class="w-full px-4 py-3 bg-[#f5f0e8]/50 border border-[#e8e0d5] rounded-xl focus:border-[#c9a84c] transition-all text-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-bold file:uppercase file:tracking-wider file:bg-[#c9a84c] file:text-white hover:file:bg-[#b8973d] file:cursor-pointer cursor-pointer">
                        <p class="text-[11px] text-[#8a7f73] mt-2">Supported formats: JPG, PNG, WebP, GIF</p>
                        <% if (editing && editing.thumbnailUrl) { %>
                            <img src="<%= editing.thumbnailUrl %>" class="mt-3 w-24 h-16 object-cover rounded-lg border border-[#e8e0d5]" alt="Current thumbnail">
                        <% } %>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-widest text-[#2d2d2d] mb-2">Trailer File (Optional)</label>
                        <input type="file" name="trailerFile" accept="video/*"
                            class="w-full px-4 py-3 bg-[#f5f0e8]/50 border border-[#e8e0d5] rounded-xl focus:border-[#c9a84c] transition-all text-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-bold file:uppercase file:tracking-wider file:bg-[#f5f0e8] file:text-[#1a1a2e] hover:file:bg-[#e8e0d5] file:cursor-pointer cursor-pointer">
                        <p class="text-[11px] text-[#8a7f73] mt-2">Supported formats: MP4, MOV, WebM, AVI, MKV</p>
                        <% if (editing && editing.trailerUrl) { %>
                            <p class="text-[11px] text-[#8a7f73] mt-2">Current file: <span class="font-medium"><%= editing.trailerUrl.split('/').pop() %></span></p>
                        <% } %>
                    </div>
                </div>

                <div class="pt-6">
                    <button type="submit"
                        class="w-full bg-[#1a1a2e] hover:bg-[#252542] text-[#c9a84c] font-bold py-4 rounded-xl shadow-lg border border-[#c9a84c]/30 transform transition-all active:scale-[0.98] flex items-center justify-center gap-2">
                        <i class="fa-solid fa-upload"></i>
                        <%= editing && editing.id ? 'Save Changes' : 'Upload Film' %>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <footer class="mt-20 py-10 flex flex-col items-center">
        <span class="text-[10px] uppercase tracking-[0.2em] text-[#8a7f73] font-bold">Cultured Africa Admin Portal</span>
        <p class="text-[10px] text-[#8a7f73]/60 mt-2">© 2026 Cultured Africa. All rights reserved.</p>
    </footer>
</main>
</body>
</html>
