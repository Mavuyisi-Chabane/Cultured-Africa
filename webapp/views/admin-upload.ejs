<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: editing ? 'Cultured Africa — Edit Film' : 'Cultured Africa — Admin Upload' }) %>
<style>
    /* A field with a problem: red outline here, and its message right under it. */
    #filmForm .field-invalid { border-color: #ff7a5c !important; box-shadow: 0 0 0 2px rgba(255, 122, 92, 0.35); }
    /* Thumbnail options: a card per choice, highlighted when picked. */
    #filmForm .thumb-choice { display: flex; cursor: pointer; position: relative; }
    #filmForm .thumb-choice input { position: absolute; opacity: 0; pointer-events: none; }
    #filmForm .thumb-choice span { flex: 1; display: flex; align-items: center; gap: 8px; padding: 12px 14px; border-radius: 12px;
        border: 1px solid #fb6b10; background: transparent; color: #fb6b10; font-size: 13px; font-weight: 700; transition: all .15s; }
    #filmForm .thumb-choice:hover span { background: rgba(251, 107, 16, 0.12); }
    #filmForm .thumb-choice input:checked + span { background: #fb6b10; border-color: #fb6b10; color: #140d0a; }
    #filmForm .thumb-choice input:focus-visible + span { outline: 2px solid #fcaa13; outline-offset: 2px; }
    #filmForm .label-invalid { color: #ff7a5c !important; }
    #filmForm .field-error { color: #ff7a5c; font-size: 12px; font-weight: 600; margin-top: 6px; }
</style>
</head>
<body class="min-h-screen">
<% const active = 'films' %>
<%- include('partials/admin-header', { active }) %>

<main id="main" class="max-w-7xl mx-auto px-6 py-12 relative">
    <div class="absolute inset-0 pattern-overlay pointer-events-none"></div>

    <div class="flex flex-col items-center">
        <div id="upload-card" class="w-full max-w-[700px] bg-[#1e1613] rounded-[24px] shadow-xl shadow-black/5 p-8 md:p-12 z-10">
            <div class="flex items-center justify-between mb-8">
                <h1 class="display-font text-2xl md:text-3xl font-bold text-[#f7efe6]"><%= editing && editing.id ? 'Edit Film' : 'Upload New Film' %></h1>
                <div class="bg-[#271c17] p-3 rounded-full">
                    <i class="fa-solid fa-cloud-arrow-up text-[#fcaa13] text-xl"></i>
                </div>
            </div>

            <% if (success) { %>
                <div class="mb-6 px-4 py-3 rounded-xl bg-[#271c17] text-[#9db183] text-sm font-medium flex items-center gap-2">
                    <i class="fa-solid fa-circle-check"></i> Film uploaded successfully! It's now live in the catalogue.
                </div>
            <% } %>

            <div id="formErrorSummary" role="alert" class="<%= error ? '' : 'hidden' %> mb-6 px-4 py-3 rounded-xl bg-[#b62319]/15 text-[#ff7a5c] text-sm font-medium">
                <p id="formErrorText"><%= error ? error + (errorField ? ' The field to fix is highlighted below.' : '') : '' %></p>
                <% if (error && filesDropped) { %>
                    <p class="mt-1 text-[#f7efe6]/80 font-normal">Everything you typed has been kept, but browsers can't keep chosen files after an error. Please choose your video, trailer and thumbnail files again.</p>
                <% } %>
            </div>

            <form id="filmForm" class="space-y-6" method="POST" enctype="multipart/form-data" novalidate
                data-error-field="<%= errorField || '' %>" data-error="<%= error || '' %>"
                data-editing="<%= editing && editing.id ? 'yes' : '' %>"
                data-has-video="<%= editing && editing.id && editing.videoUrl ? 'yes' : '' %>"
                data-has-trailer="<%= editing && editing.id && editing.trailerUrl ? 'yes' : '' %>"
                data-max-video-bytes="<%= uploadLimits.videoBytes %>" data-max-image-bytes="<%= uploadLimits.imageBytes %>"
                action="<%= editing && editing.id ? '/admin/films/' + editing.id + '/edit' : '/admin/upload' %>?_csrf=<%= csrfToken %>">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="md:col-span-2">
                        <label for="titleInput" class="block text-xs font-bold uppercase tracking-widest text-[#f7efe6] mb-2">Film Title <span class="text-[#fcaa13]">*</span></label>
                        <input type="text" name="title" id="titleInput" placeholder="Enter film name" value="<%= editing ? editing.title || '' : '' %>" required
                            class="w-full px-4 py-3 bg-[#271c17]/50 border border-[#38281f] rounded-xl focus:border-[#fcaa13] transition-all">
                    </div>

                    <div class="md:col-span-2">
                        <label for="descriptionInput" class="block text-xs font-bold uppercase tracking-widest text-[#f7efe6] mb-2">Description <span class="text-[#fcaa13]">*</span></label>
                        <textarea name="description" id="descriptionInput" rows="4" placeholder="Describe the film and its cultural significance..." required
                            class="w-full px-4 py-3 bg-[#271c17]/50 border border-[#38281f] rounded-xl focus:border-[#fcaa13] transition-all resize-none"><%= editing ? editing.description || '' : '' %></textarea>
                    </div>

                    <div>
                        <label for="cultureSelect" class="block text-xs font-bold uppercase tracking-widest text-[#f7efe6] mb-2">Culture Category <span class="text-[#fcaa13]">*</span></label>
                        <%
                            const otherCulture = editing && editing.culture === '__other__';
                            const listedCulture = editing && cultures.includes(editing.culture);
                        %>
                        <select name="culture" id="cultureSelect" class="w-full px-4 py-3 bg-[#271c17]/50 border border-[#38281f] rounded-xl focus:border-[#fcaa13] transition-all appearance-none cursor-pointer">
                            <option value="" <%= otherCulture || listedCulture ? '' : 'selected' %> disabled>Choose a culture…</option>
                            <% cultures.forEach(c => { %>
                                <option value="<%= c %>" <%= editing && editing.culture === c ? 'selected' : '' %>><%= c %></option>
                            <% }) %>
                            <option value="__other__" <%= otherCulture ? 'selected' : '' %>>Other (not in the list): type it in…</option>
                        </select>
                        <div id="newCultureField" class="mt-3 <%= otherCulture ? '' : 'hidden' %>">
                            <input type="text" name="newCulture" id="newCultureInput" maxlength="50"
                                value="<%= editing && editing.newCulture ? editing.newCulture : '' %>"
                                placeholder="Type the culture's name, e.g. Lobedu"
                                <%= otherCulture ? 'required' : 'disabled' %>
                                class="w-full px-4 py-3 bg-[#271c17]/50 border border-[#38281f] rounded-xl focus:border-[#fcaa13] transition-all">
                            <p class="text-[11px] text-[#a99a8b] mt-1">It will be added to the culture list for future uploads. If it already exists, the existing culture is used.</p>
                        </div>
                    </div>

                    <div>
                        <label for="priceInput" class="block text-xs font-bold uppercase tracking-widest text-[#f7efe6] mb-2">Price (ZAR) <span class="text-[#fcaa13]">*</span></label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-[#a99a8b] font-bold">R</span>
                            <input type="number" step="0.01" name="price" id="priceInput" value="<%= editing ? (editing.price || 50) : 50 %>"
                                class="w-full pl-8 pr-4 py-3 bg-[#271c17]/50 border border-[#38281f] rounded-xl focus:border-[#fcaa13] transition-all">
                        </div>
                    </div>

                    <% const selectedGenre = editing ? (editing.genre || '') : ''; %>
                    <div>
                        <label for="genre" class="block text-xs font-bold uppercase tracking-widest text-[#f7efe6] mb-2">Genre <span class="text-[#fcaa13]">*</span></label>
                        <select name="genre" id="genre" required class="w-full px-4 py-3 bg-[#271c17]/50 border border-[#38281f] rounded-xl focus:border-[#fcaa13] transition-all appearance-none cursor-pointer">
                            <option value="" <%= genres.includes(selectedGenre) ? '' : 'selected' %> disabled>Choose a genre…</option>
                            <% genres.forEach(g => { %>
                                <option value="<%= g %>" <%= selectedGenre === g ? 'selected' : '' %>><%= g %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div>
                        <span class="block text-xs font-bold uppercase tracking-widest text-[#f7efe6] mb-2">Length</span>
                        <input type="hidden" name="durationSeconds" id="durationSeconds" value="<%= editing && editing.durationSeconds ? editing.durationSeconds : '' %>">
                        <p id="durationDisplay" class="px-4 py-3 bg-[#271c17]/30 border border-dashed border-[#38281f] rounded-xl text-sm text-[#f7efe6]">
                            <%= editing && editing.durationLabel ? editing.durationLabel : 'Detected automatically from the video' %>
                        </p>
                    </div>

                    <div class="md:col-span-2 flex items-center gap-3 py-2">
                        <label class="relative inline-flex items-center cursor-pointer">
                            <%
                            // After a rejected submit, `editing` is the form (isFree is 'true' or missing);
                            // on the edit page it's the saved film (free means price 0).
                            const freeChecked = editing && (editing.isFree !== undefined ? editing.isFree === 'true' : editing.price === 0);
                        %>
                            <input type="checkbox" name="isFree" id="isFreeInput" value="true" class="sr-only peer" aria-label="This film is free" <%= freeChecked ? 'checked' : '' %>>
                            <div class="w-11 h-6 bg-[#38281f] peer-focus-visible:ring-2 peer-focus-visible:ring-[#fcaa13] rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-[#38281f] after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-[#1e1613] after:border-[#38281f] after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#fb6b10]"></div>
                        </label>
                        <span class="text-sm font-medium text-[#f7efe6]">This film is free</span>
                    </div>

                    <% if (ageRatingsEnabled) { %>
                    <%
                        // On a re-render after a validation error, `editing` is the submitted form
                        // (ageRating / advisories); when opening the edit page, it's the saved film.
                        const selectedRating = editing ? (editing.ageRating !== undefined ? editing.ageRating : editing.ageRatingCode) : '';
                        const selectedAdvisories = editing ? [].concat(editing.advisories !== undefined ? editing.advisories : (editing.advisoryCodes || [])) : [];
                    %>
                    <div>
                        <label for="ageRating" class="block text-xs font-bold uppercase tracking-widest text-[#f7efe6] mb-2">Age Rating <span class="text-[#fcaa13]">*</span></label>
                        <select name="ageRating" id="ageRating" required
                            class="w-full px-4 py-3 bg-[#271c17]/50 border border-[#38281f] rounded-xl focus:border-[#fcaa13] transition-all appearance-none cursor-pointer">
                            <option value="" <%= selectedRating ? '' : 'selected' %> disabled>Choose a rating…</option>
                            <% ageRatings.forEach(r => { %>
                                <option value="<%= r.code %>" data-description="<%= r.description %>" <%= selectedRating === r.code ? 'selected' : '' %>><%= r.code %> — <%= r.label %></option>
                            <% }) %>
                        </select>
                        <p id="ageRatingHelp" class="text-[11px] text-[#a99a8b] mt-2">South African Film and Publication Board (FPB) classification. Shown to viewers on every film card and film page.</p>
                    </div>

                    <fieldset>
                        <legend class="block text-xs font-bold uppercase tracking-widest text-[#f7efe6] mb-2">Consumer Advice (Optional)</legend>
                        <div class="flex flex-wrap gap-2">
                            <% contentAdvisories.forEach(a => { %>
                                <label class="cursor-pointer">
                                    <input type="checkbox" name="advisories" value="<%= a.code %>" class="peer sr-only" <%= selectedAdvisories.includes(a.code) ? 'checked' : '' %>>
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-[#38281f] bg-[#271c17]/50 text-xs font-bold text-[#a99a8b] transition-all peer-checked:border-[#fcaa13] peer-checked:text-[#fcaa13] peer-focus-visible:ring-2 peer-focus-visible:ring-[#fcaa13]">
                                        <span class="font-mono"><%= a.code %></span> <%= a.label %>
                                    </span>
                                </label>
                            <% }) %>
                        </div>
                        <p class="text-[11px] text-[#a99a8b] mt-2">Tick anything viewers should be warned about.</p>
                    </fieldset>
                    <% } %>

                    <%
                        const isEditingFilm = Boolean(editing && editing.id);
                        const editingComingSoon = isEditingFilm && !editing.videoUrl;
                        const comingSoonChecked = !isEditingFilm && editing && editing.comingSoon === 'yes';
                    %>
                    <% if (isEditingFilm && editingComingSoon) { %>
                        <div class="md:col-span-2 rounded-xl border border-[#fcaa13]/40 bg-[#271c17]/50 p-4 text-sm text-[#f7efe6]">
                            <p class="font-bold text-[#fcaa13] mb-1"><i class="fa-solid fa-clock mr-1"></i> This film is "Coming soon"</p>
                            <p class="text-[#a99a8b]">Customers can watch its trailer but can't buy it yet. Add the full video below and save to release it for sale.</p>
                        </div>
                    <% } else if (!isEditingFilm) { %>
                        <div class="md:col-span-2 flex items-start gap-3 rounded-xl border border-[#38281f] bg-[#271c17]/30 p-4">
                            <input type="checkbox" id="comingSoon" name="comingSoon" value="yes" <%= comingSoonChecked ? 'checked' : '' %>
                                class="mt-1 h-5 w-5 flex-shrink-0 accent-[#fb6b10] cursor-pointer">
                            <label for="comingSoon" class="cursor-pointer">
                                <span class="block text-sm font-bold text-[#f7efe6]">Coming soon: I only have the trailer for now</span>
                                <span class="block text-[11px] text-[#a99a8b] mt-1">The film is listed with its trailer and a "Coming soon" label, and can't be bought yet. Add the full video later through Edit to release it.</span>
                            </label>
                        </div>
                    <% } %>

                    <div class="md:col-span-2">
                        <label for="videoInput" class="block text-xs font-bold uppercase tracking-widest text-[#f7efe6] mb-2">
                            Video File <span id="videoRequiredMark" class="text-[#fcaa13] <%= (isEditingFilm || comingSoonChecked) ? 'hidden' : '' %>">*</span>
                        </label>
                        <input type="file" name="videoFile" id="videoInput" accept=".mp4,.m4v,.webm,.mov,video/mp4,video/webm,video/quicktime" <%= (isEditingFilm || comingSoonChecked) ? '' : 'required' %>
                            class="w-full px-4 py-3 bg-[#271c17]/50 border border-[#38281f] rounded-xl focus:border-[#fcaa13] transition-all text-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-bold file:uppercase file:tracking-wider file:bg-[#fb6b10] file:text-[#f4ece3] hover:file:bg-[#ef420f] file:cursor-pointer cursor-pointer">
                        <p class="text-[11px] text-[#a99a8b] mt-2">Supported formats: MP4 (recommended), WebM, MOV. Maximum 9 GB.</p>
                        <% if (editing && editing.videoUrl) { %>
                            <p class="text-[11px] text-[#a99a8b] mt-2">Current file: <span class="font-medium"><%= editing.videoUrl.split('/').pop() %></span> — choose a new file to replace it.</p>
                        <% } %>
                    </div>

                    <%
                        // A thumbnail can be grabbed from the film's current video only if it's a real
                        // uploaded video file (the seeded demo films point at placeholder images instead).
                        const currentVideoUsable = Boolean(editing && editing.id && editing.videoUrl &&
                            editing.videoUrl.startsWith('/uploads/') && /\.(mp4|webm|mov|m4v|ogv)$/i.test(editing.videoUrl));
                        const currentTrailerUsable = Boolean(editing && editing.id && editing.trailerUrl &&
                            editing.trailerUrl.startsWith('/uploads/') && /\.(mp4|webm|mov|m4v|ogv)$/i.test(editing.trailerUrl));
                    %>
                    <%
                        // How the thumbnail is chosen. New films default to a frame from the video;
                        // when editing, the current thumbnail is kept unless the admin picks otherwise.
                        const thumbModes = isEditingFilm ? ['keep', 'frame', 'upload'] : ['frame', 'upload'];
                        const thumbMode = editing && thumbModes.includes(editing.thumbnailMode) ? editing.thumbnailMode : thumbModes[0];
                    %>
                    <fieldset class="md:col-span-2" id="thumbnailSection">
                        <legend class="block text-xs font-bold uppercase tracking-widest text-[#f7efe6] mb-2">Thumbnail <span class="text-[#fcaa13]">*</span></legend>
                        <p class="text-[11px] text-[#a99a8b] mb-3">The picture shown for this film in the catalogue. Choose one option.</p>

                        <div class="grid grid-cols-1 <%= isEditingFilm ? 'sm:grid-cols-3' : 'sm:grid-cols-2' %> gap-3">
                            <% if (isEditingFilm) { %>
                                <label class="thumb-choice">
                                    <input type="radio" name="thumbnailMode" value="keep" <%= thumbMode === 'keep' ? 'checked' : '' %>>
                                    <span><i class="fa-solid fa-image"></i> Keep the current thumbnail</span>
                                </label>
                            <% } %>
                            <label class="thumb-choice">
                                <input type="radio" name="thumbnailMode" value="frame" <%= thumbMode === 'frame' ? 'checked' : '' %>>
                                <span><i class="fa-solid fa-film"></i> Use a frame from the video</span>
                            </label>
                            <label class="thumb-choice">
                                <input type="radio" name="thumbnailMode" value="upload" <%= thumbMode === 'upload' ? 'checked' : '' %>>
                                <span><i class="fa-solid fa-upload"></i> Upload my own image</span>
                            </label>
                        </div>

                        <% if (isEditingFilm && editing.thumbnailUrl) { %>
                            <div id="thumbKeepPanel" class="<%= thumbMode === 'keep' ? '' : 'hidden' %> mt-4 flex items-center gap-4">
                                <img src="<%= editing.thumbnailUrl %>" class="w-32 h-20 object-cover rounded-lg border border-[#38281f]" alt="Current thumbnail">
                                <% if (editing.usesPlaceholderThumbnail) { %>
                                    <p class="text-[11px] text-[#fcaa13]">This film is using the Cultured Africa placeholder image. Choose a frame from the video or upload an image to replace it.</p>
                                <% } else { %>
                                    <p class="text-[11px] text-[#a99a8b]">This is the current thumbnail.</p>
                                <% } %>
                            </div>
                        <% } %>

                        <div id="thumbPicker" class="<%= thumbMode === 'frame' ? '' : 'hidden' %> mt-4 rounded-xl border border-[#38281f] bg-[#271c17]/30 p-4"
                            data-current-video="<%= currentVideoUsable ? editing.videoUrl : (currentTrailerUsable ? editing.trailerUrl : '') %>">
                            <div class="flex flex-col sm:flex-row gap-4">
                                <div class="w-full sm:w-64 aspect-video rounded-lg bg-black overflow-hidden flex-shrink-0">
                                    <img id="thumbPreview" class="w-full h-full object-contain hidden" alt="Thumbnail preview">
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p id="thumbStatus" class="text-xs text-[#f7efe6] leading-relaxed">Choose the video file above and a frame will be picked from it automatically.</p>
                                    <div id="thumbControls" class="hidden">
                                        <input type="range" id="thumbSlider" min="0" max="1" step="0.1" value="0" class="w-full mt-3 accent-[#fb6b10] cursor-pointer" aria-label="Choose the moment in the video to use as the thumbnail">
                                        <div class="flex justify-between text-[10px] text-[#a99a8b]"><span id="thumbTime">0:00</span><span id="thumbDuration">0:00</span></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="thumbUploadPanel" class="<%= thumbMode === 'upload' ? '' : 'hidden' %> mt-4">
                            <label for="thumbnailInput" class="block text-[11px] font-bold uppercase tracking-widest text-[#f7efe6] mb-2">Your image</label>
                            <input type="file" name="thumbnailFile" id="thumbnailInput" accept=".jpg,.jpeg,.png,.webp,.gif,image/jpeg,image/png,image/webp,image/gif"
                                class="w-full px-4 py-3 bg-[#271c17]/50 border border-[#38281f] rounded-xl focus:border-[#fcaa13] transition-all text-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-bold file:uppercase file:tracking-wider file:bg-[#fb6b10] file:text-[#f4ece3] hover:file:bg-[#ef420f] file:cursor-pointer cursor-pointer">
                            <p class="text-[11px] text-[#a99a8b] mt-2">Supported formats: JPG, PNG, WebP, GIF. Maximum 10 MB. A wide (landscape) picture works best.</p>
                        </div>
                    </fieldset>

                    <%
                        // Every film needs a trailer; when editing one that already has a trailer,
                        // choosing a new file is optional (it replaces the current one).
                        const trailerRequired = !(isEditingFilm && editing.trailerUrl);
                    %>
                    <div class="md:col-span-2">
                        <label for="trailerInput" class="block text-xs font-bold uppercase tracking-widest text-[#f7efe6] mb-2">Trailer File <% if (trailerRequired) { %><span class="text-[#fcaa13]">*</span><% } %></label>
                        <input type="file" name="trailerFile" id="trailerInput" <%= trailerRequired ? 'required' : '' %> accept=".mp4,.m4v,.webm,.mov,video/mp4,video/webm,video/quicktime"
                            class="w-full px-4 py-3 bg-[#271c17]/50 border border-[#38281f] rounded-xl focus:border-[#fcaa13] transition-all text-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-bold file:uppercase file:tracking-wider file:bg-[#fb6b10] file:text-[#f4ece3] hover:file:bg-[#ef420f] file:cursor-pointer cursor-pointer">
                        <p class="text-[11px] text-[#a99a8b] mt-2">Every film needs a trailer. Supported formats: MP4 (recommended), WebM, MOV. Maximum 9 GB.</p>
                        <p class="text-[11px] text-[#fcaa13] mt-1">Trailers are featured on the public home page, where anyone can watch them without logging in. MP4 plays in every browser.</p>
                        <% if (editing && editing.trailerUrl) { %>
                            <p class="text-[11px] text-[#a99a8b] mt-2">Current file: <span class="font-medium"><%= editing.trailerUrl.split('/').pop() %></span> — choose a new file to replace it.</p>
                        <% } %>
                    </div>
                </div>

                <div class="pt-6">
                    <button type="submit" id="submitBtn"
                        class="w-full bg-[#fb6b10] hover:bg-[#ef420f] text-[#140d0a] font-bold py-4 rounded-xl shadow-lg shadow-[#fb6b10]/20 transform transition-all active:scale-[0.98] flex items-center justify-center gap-2">
                        <i class="fa-solid fa-upload"></i>
                        <%= editing && editing.id ? 'Save Changes' : 'Upload Film' %>
                    </button>

                    <div id="uploadProgress" class="hidden mt-5 rounded-xl border border-[#38281f] bg-[#271c17]/40 p-5" role="status" aria-live="polite">
                        <div class="flex items-baseline justify-between gap-4">
                            <p id="uploadTitle" class="text-sm font-bold text-[#f7efe6]">Uploading…</p>
                            <p id="uploadPercent" class="text-2xl font-bold text-[#fcaa13] tabular-nums">0%</p>
                        </div>
                        <div class="mt-3 h-3 rounded-full bg-[#140d0a] overflow-hidden" role="progressbar" aria-label="Upload progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="uploadBarTrack">
                            <div id="uploadBar" class="h-full w-0 rounded-full bg-gradient-to-r from-[#ef420f] via-[#fb6b10] to-[#fcaa13] transition-[width] duration-300"></div>
                        </div>
                        <div class="mt-2 flex flex-wrap justify-between gap-2 text-xs text-[#a99a8b]">
                            <span id="uploadSent">0 MB of 0 MB</span>
                            <span id="uploadEta"></span>
                        </div>
                        <p class="mt-3 text-[11px] text-[#a99a8b]">Keep this page open until the upload finishes. Large films can take a while on a slow connection.</p>
                        <button type="button" id="uploadCancel" class="mt-3 text-xs font-bold text-[#fb6b10] hover:text-[#ef420f] hover:underline">Cancel upload</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <footer class="mt-20 py-10 flex flex-col items-center">
        <span class="text-[10px] uppercase tracking-[0.2em] text-[#a99a8b] font-bold">Cultured Africa Admin Portal</span>
        <p class="text-[10px] text-[#a99a8b]/60 mt-2">© 2026 Cultured Africa. All rights reserved.</p>
    </footer>
</main>
<script>
    // Show the free-text culture box only when "Other" is chosen; disabled (not just hidden)
    // otherwise, so a stale value is never submitted and `required` doesn't block the form.
    (function () {
        const select = document.getElementById('cultureSelect');
        const field = document.getElementById('newCultureField');
        const input = document.getElementById('newCultureInput');
        function sync(focus) {
            const isOther = select.value === '__other__';
            field.classList.toggle('hidden', !isOther);
            input.disabled = !isOther;
            input.required = isOther;
            if (isOther && focus) input.focus();
        }
        select.addEventListener('change', () => sync(true));
        sync(false); // match the box to whatever the list shows when the page opens
    })();

    // "Coming soon": the full video becomes optional (a trailer is needed either way).
    (function () {
        const box = document.getElementById('comingSoon');
        if (!box) return;
        const video = document.getElementById('videoInput');
        function sync() {
            video.required = !box.checked;
            document.getElementById('videoRequiredMark').classList.toggle('hidden', box.checked);
        }
        box.addEventListener('change', sync);
        sync();
    })();

    // Checks the form in the browser before anything is sent, so a mistake never costs the
    // admin their chosen files (browsers can't refill a file input after the page reloads).
    // Each problem outlines its field in red with the message right under it. The server
    // repeats these checks; when it rejects something, the field it names is marked the same way.
    (function () {
        const form = document.getElementById('filmForm');
        const summary = document.getElementById('formErrorSummary');
        const summaryText = document.getElementById('formErrorText');
        const isEditing = form.dataset.editing === 'yes';
        const VIDEO_EXT = ['mp4', 'm4v', 'webm', 'mov'];
        const IMAGE_EXT = ['jpg', 'jpeg', 'png', 'webp', 'gif'];
        const maxVideo = Number(form.dataset.maxVideoBytes);
        const maxImage = Number(form.dataset.maxImageBytes);
        const GB = 1024 * 1024 * 1024;
        // The message box at the top is about highlighted fields (so it goes once they're
        // all fixed), rather than a general problem that should stay on screen.
        let summaryIsAboutFields = false;

        const field = name => form.elements[name];
        // Where the message goes: under the price box as a whole, otherwise under the field.
        const anchorFor = el => el.id === 'priceInput' ? el.parentElement : el;

        function clearError(name) {
            const el = field(name);
            if (!el || !el.classList) return; // a group of options (e.g. thumbnailMode) has no single box
            el.classList.remove('field-invalid');
            el.removeAttribute('aria-invalid');
            const label = el.id && form.querySelector('label[for="' + el.id + '"]');
            if (label) label.classList.remove('label-invalid');
            const msg = document.getElementById('err-' + name);
            if (msg) msg.remove();
            if (summaryIsAboutFields && !form.querySelector('.field-invalid')) summary.classList.add('hidden');
        }

        function showError(name, message) {
            const el = field(name);
            if (!el || !el.classList) return false;
            clearError(name);
            el.classList.add('field-invalid');
            el.setAttribute('aria-invalid', 'true');
            const label = el.id && form.querySelector('label[for="' + el.id + '"]');
            if (label) label.classList.add('label-invalid');
            const msg = document.createElement('p');
            msg.id = 'err-' + name;
            msg.className = 'field-error';
            msg.innerHTML = '<i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> ';
            msg.appendChild(document.createTextNode(message));
            anchorFor(el).insertAdjacentElement('afterend', msg);
            el.setAttribute('aria-describedby', msg.id);
            return true;
        }

        const ext = file => (file.name.split('.').pop() || '').toLowerCase();
        const chosen = name => field(name) && field(name).files && field(name).files[0];

        function checkVideoFile(name, label) {
            const file = chosen(name);
            if (!file) return null;
            if (!VIDEO_EXT.includes(ext(file))) return label + ' must be an MP4, WebM or MOV file.';
            if (file.size > maxVideo) return label + ' is too large. Videos can be at most ' + +(maxVideo / GB).toFixed(1) + ' GB, so please compress it first.';
            return null;
        }

        function validate() {
            const errors = [];
            const add = (name, message) => errors.push({ name, message });
            const comingSoon = document.getElementById('comingSoon');
            const isComingSoon = Boolean(comingSoon && comingSoon.checked);

            if (!field('title').value.trim()) add('title', 'Please enter the film\'s title.');
            if (!field('description').value.trim()) add('description', 'Please enter a description.');

            if (!field('culture').value) add('culture', 'Please choose a culture, or choose "Other" at the bottom of the list and type it in.');
            else if (field('culture').value === '__other__') {
                const name = field('newCulture').value.trim().replace(/\s+/g, ' ');
                if (!name) add('newCulture', 'Please type the name of the culture.');
                else if (name.length > 50) add('newCulture', 'Culture names must be 50 characters or fewer.');
                else if (!/^\p{L}[\p{L}\p{M}' -]*$/u.test(name)) add('newCulture', 'Culture names may only contain letters, spaces, hyphens and apostrophes.');
            }

            if (!document.getElementById('isFreeInput').checked) {
                const price = field('price').value.trim();
                if (price === '' || isNaN(Number(price))) add('price', 'Please enter a price, or switch on "This film is free".');
                else if (Number(price) < 0) add('price', 'The price can\'t be negative.');
            }

            if (!field('genre').value) add('genre', 'Please choose a genre.');
            if (field('ageRating') && !field('ageRating').value) add('ageRating', 'Please choose an age rating for this film.');

            const videoProblem = checkVideoFile('videoFile', 'The video');
            if (videoProblem) add('videoFile', videoProblem);
            else if (!isEditing && !isComingSoon && !chosen('videoFile')) {
                add('videoFile', 'Please choose the film\'s video file, or tick "Coming soon" if you only have the trailer for now.');
            }

            const trailerProblem = checkVideoFile('trailerFile', 'The trailer');
            if (trailerProblem) add('trailerFile', trailerProblem);
            else if (!chosen('trailerFile') && form.dataset.hasTrailer !== 'yes') {
                add('trailerFile', 'Please choose the film\'s trailer. Every film needs one, so viewers can preview it before buying.');
            }

            const thumbMode = (form.querySelector('input[name="thumbnailMode"]:checked') || {}).value;
            const thumb = chosen('thumbnailFile');
            if (thumbMode === 'upload' && !thumb) add('thumbnailFile', 'Please choose your image, or pick "Use a frame from the video" instead.');
            else if (thumb && !IMAGE_EXT.includes(ext(thumb))) add('thumbnailFile', 'The thumbnail must be a JPG, PNG, WebP or GIF image.');
            else if (thumb && thumb.size > maxImage) add('thumbnailFile', 'The thumbnail image is too large. Images can be at most ' + maxImage / (1024 * 1024) + ' MB.');

            return errors;
        }

        // Something to scroll to that is actually on screen (a hidden field has no position).
        const onScreen = el => el.getClientRects().length ? el : (el.closest('div:not(.hidden)') || form);

        function report(errors) {
            // Top of the page first, so the scroll goes to the first problem you'd meet.
            errors.sort((a, b) => field(a.name).compareDocumentPosition(field(b.name)) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1);
            errors.forEach(e => showError(e.name, e.message));
            summaryText.textContent = errors.length === 1
                ? 'Please fix the highlighted field below. Nothing has been lost.'
                : 'Please fix the ' + errors.length + ' highlighted fields below. Nothing has been lost.';
            summary.classList.remove('hidden');
            summaryIsAboutFields = true;
            const first = field(errors[0].name);
            onScreen(first).scrollIntoView({ behavior: 'smooth', block: 'center' });
            first.focus({ preventScroll: true });
        }

        form.addEventListener('submit', event => {
            form.querySelectorAll('.field-invalid').forEach(el => clearError(el.name));
            const errors = validate();
            if (errors.length) {
                event.preventDefault();
                report(errors);
            }
        });

        // Fixing a field clears its message straight away.
        form.addEventListener('input', event => { if (event.target.name) clearError(event.target.name); });
        form.addEventListener('change', event => {
            if (!event.target.name) return;
            clearError(event.target.name);
            if (event.target.name === 'comingSoon') { clearError('videoFile'); clearError('trailerFile'); }
            if (event.target.name === 'isFree') clearError('price');
            if (event.target.name === 'culture') clearError('newCulture');
        });

        // The server turned the form down: mark the field it named.
        if (form.dataset.errorField && showError(form.dataset.errorField, form.dataset.error)) {
            summaryIsAboutFields = true;
            const el = field(form.dataset.errorField);
            onScreen(el).scrollIntoView({ block: 'center' });
            el.focus({ preventScroll: true });
        }
    })();

    // Upload progress: once the form passes its checks, it's sent in the background so a bar can
    // show how much has gone up and roughly how long is left. The server replies exactly as it
    // would to a normal submit: a redirect when the film is saved (followed here), or the form
    // again with an error, which then replaces this page. Leaving mid-upload asks first.
    (function () {
        const form = document.getElementById('filmForm');
        const button = document.getElementById('submitBtn');
        const box = document.getElementById('uploadProgress');
        const title = document.getElementById('uploadTitle');
        const percent = document.getElementById('uploadPercent');
        const bar = document.getElementById('uploadBar');
        const track = document.getElementById('uploadBarTrack');
        const sent = document.getElementById('uploadSent');
        const eta = document.getElementById('uploadEta');
        const cancel = document.getElementById('uploadCancel');
        if (!window.FormData || !window.XMLHttpRequest) return; // old browser: a normal submit

        let xhr = null;
        const warnOnLeave = event => { event.preventDefault(); event.returnValue = ''; };

        function size(bytes) {
            return bytes >= 1024 ** 3 ? (bytes / 1024 ** 3).toFixed(2) + ' GB' : Math.max(0.1, bytes / 1024 ** 2).toFixed(1) + ' MB';
        }
        function duration(seconds) {
            if (!isFinite(seconds) || seconds <= 0) return '';
            if (seconds < 60) return 'less than a minute left';
            const m = Math.round(seconds / 60);
            return m < 60 ? 'about ' + m + ' min left' : 'about ' + Math.floor(m / 60) + ' h ' + (m % 60) + ' min left';
        }
        function finish() {
            window.removeEventListener('beforeunload', warnOnLeave);
            xhr = null;
        }
        function reset(message) {
            finish();
            box.classList.add('hidden');
            button.disabled = false;
            button.classList.remove('opacity-60', 'cursor-not-allowed');
            if (message) {
                const summary = document.getElementById('formErrorSummary');
                document.getElementById('formErrorText').textContent = message;
                summary.classList.remove('hidden');
                summary.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        form.addEventListener('submit', event => {
            if (event.defaultPrevented || xhr) return; // the checks found a problem, or already sending
            event.preventDefault();

            const req = xhr = new XMLHttpRequest(); // `xhr` is cleared when done; `req` stays for the handlers
            const started = Date.now();
            let rate = 0; // bytes per second, smoothed

            button.disabled = true;
            button.classList.add('opacity-60', 'cursor-not-allowed');
            box.classList.remove('hidden');
            title.textContent = 'Uploading…';
            window.addEventListener('beforeunload', warnOnLeave);

            req.upload.addEventListener('progress', e => {
                if (!e.lengthComputable) return;
                const pct = Math.min(100, Math.floor(e.loaded / e.total * 100));
                percent.textContent = pct + '%';
                bar.style.width = pct + '%';
                track.setAttribute('aria-valuenow', pct);
                sent.textContent = size(e.loaded) + ' of ' + size(e.total);
                const elapsed = (Date.now() - started) / 1000;
                if (elapsed > 2) {
                    const now = e.loaded / elapsed;
                    rate = rate ? rate * 0.7 + now * 0.3 : now;
                    eta.textContent = duration((e.total - e.loaded) / rate);
                }
            });
            req.upload.addEventListener('load', () => {
                percent.textContent = '100%';
                bar.style.width = '100%';
                title.textContent = 'Upload complete. Saving the film…';
                eta.textContent = '';
                cancel.classList.add('hidden');
            });

            req.addEventListener('load', () => {
                // A redirect means it was saved (it lands on a different address, e.g. ?success=1).
                const redirected = req.responseURL && req.responseURL !== new URL(form.action, location.href).href;
                finish();
                if (req.status >= 200 && req.status < 300 && redirected) {
                    location.href = req.responseURL; // saved: go where the server sent us
                } else if (req.status >= 200 && req.status < 300) {
                    document.open(); document.write(req.responseText); document.close(); // the form, with its error
                } else if (req.status === 413) {
                    reset('These files are too large for the server to accept. Please compress the video and try again.');
                } else {
                    reset('The upload could not be completed (error ' + req.status + '). Please try again.');
                }
            });
            req.addEventListener('error', () => reset('The upload stopped because the connection was lost. Please check your internet and try again; nothing was saved.'));
            req.addEventListener('abort', () => reset('Upload cancelled. Nothing was saved, and your details are still filled in.'));

            req.open('POST', form.action);
            req.send(new FormData(form));
        });

        cancel.addEventListener('click', () => {
            if (xhr && confirm('Cancel this upload? Nothing will be saved.')) xhr.abort();
        });
    })();

    // Film length: read from the video's own metadata in the browser (only the start of
    // the file is needed), for a newly chosen video or, when editing, the current one.
    (function () {
        const videoInput = document.getElementById('videoInput');
        const hidden = document.getElementById('durationSeconds');
        const display = document.getElementById('durationDisplay');
        function label(seconds) {
            const total = Math.max(1, Math.round(seconds / 60));
            const h = Math.floor(total / 60), m = total % 60;
            return h ? (m ? h + ' h ' + m + ' min' : h + ' h') : m + ' min';
        }
        function measure(src, revoke) {
            const probe = document.createElement('video');
            probe.preload = 'metadata';
            probe.muted = true;
            probe.addEventListener('loadedmetadata', function () {
                if (isFinite(probe.duration) && probe.duration > 0) {
                    hidden.value = Math.round(probe.duration);
                    display.textContent = label(probe.duration);
                }
                if (revoke) URL.revokeObjectURL(src);
            });
            probe.addEventListener('error', function () {
                display.textContent = 'Could not read the length from this video';
            });
            probe.src = src;
        }
        if (videoInput) {
            videoInput.addEventListener('change', function () {
                const file = videoInput.files && videoInput.files[0];
                if (!file) return;
                hidden.value = '';
                display.textContent = 'Reading length…';
                measure(URL.createObjectURL(file), true);
            });
        }
        // Editing a film whose length isn't known yet: measure its current video.
        const current = <%- JSON.stringify(editing && editing.id && !editing.durationSeconds && currentVideoUsable ? editing.videoUrl : null) %>;
        if (current) measure(current, false);
    })();

    // Explain the chosen age rating under the select.
    (function () {
        const select = document.getElementById('ageRating');
        const help = document.getElementById('ageRatingHelp');
        if (!select) return; // age ratings are switched off
        const defaultHelp = help.textContent;
        function update() {
            const opt = select.options[select.selectedIndex];
            help.textContent = opt && opt.dataset.description ? opt.dataset.description : defaultHelp;
        }
        select.addEventListener('change', update);
        update();
    })();

    // Thumbnail: the admin chooses how it's made (the thumbnailMode options).
    //  - "frame": a frame of the chosen video (or trailer) is drawn onto a canvas in the
    //    browser and put into the thumbnail file input as a JPEG, exactly as if it were an
    //    uploaded image — so the server needs no video tooling. A slider picks the moment.
    //  - "upload": the admin picks their own image in the same file input.
    //  - "keep" (editing only): nothing is sent and the current thumbnail stays.
    (function () {
        const videoInput = document.getElementById('videoInput');
        const trailerInput = document.getElementById('trailerInput');
        const thumbInput = document.getElementById('thumbnailInput');
        const picker = document.getElementById('thumbPicker');
        const uploadPanel = document.getElementById('thumbUploadPanel');
        const keepPanel = document.getElementById('thumbKeepPanel');
        const preview = document.getElementById('thumbPreview');
        const status = document.getElementById('thumbStatus');
        const controls = document.getElementById('thumbControls');
        const slider = document.getElementById('thumbSlider');
        const timeLabel = document.getElementById('thumbTime');
        const durationLabel = document.getElementById('thumbDuration');
        const modeInputs = [...document.querySelectorAll('input[name="thumbnailMode"]')];
        const currentVideo = picker.dataset.currentVideo;
        if (!videoInput || !thumbInput) return;
        const canCapture = Boolean(window.DataTransfer && HTMLCanvasElement.prototype.toBlob);

        const MAX_WIDTH = 1280;
        const DARK_LUMA = 25; // average brightness (0-255) below which a frame counts as "too dark"
        const probe = document.createElement('video');
        probe.muted = true;
        probe.playsInline = true;
        probe.preload = 'auto';

        let sourceUrl = null;
        let ownsSourceUrl = false;
        let sourceFile = null;     // the chosen file the current frames come from
        let previewUrl = null;
        let candidates = [];       // seek positions still to try when skipping dark frames
        let seekTimer = null;

        const mode = () => (modeInputs.find(i => i.checked) || {}).value;

        function formatTime(seconds) {
            const s = Math.max(0, Math.floor(seconds));
            const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
            const mm = h ? String(m).padStart(2, '0') : String(m);
            return (h ? h + ':' : '') + mm + ':' + String(sec).padStart(2, '0');
        }

        function setStatus(text) { status.textContent = text; }

        function setThumbnailFile(file) {
            if (!window.DataTransfer) { if (!file) thumbInput.value = ''; return; }
            const dt = new DataTransfer();
            if (file) dt.items.add(file);
            thumbInput.files = dt.files;
            thumbInput.dispatchEvent(new Event('change', { bubbles: true })); // clears any error on it
        }

        function showPreview(blob) {
            if (previewUrl) URL.revokeObjectURL(previewUrl);
            previewUrl = URL.createObjectURL(blob);
            preview.src = previewUrl;
            preview.classList.remove('hidden');
        }

        // The video to take frames from: a newly chosen video, else a newly chosen trailer,
        // else (when editing) the film's current video or trailer.
        function chosenSource() {
            const file = (videoInput.files && videoInput.files[0]) || (trailerInput && trailerInput.files && trailerInput.files[0]);
            if (file) return { file };
            if (currentVideo) return { url: currentVideo };
            return null;
        }

        function startFrames() {
            if (!canCapture) return setStatus('This browser can\'t take frames from a video. Please choose "Upload my own image" instead.');
            const source = chosenSource();
            if (!source) {
                controls.classList.add('hidden');
                preview.classList.add('hidden');
                return setStatus('Choose the video file above and a frame will be picked from it automatically.');
            }
            if (source.file && source.file === sourceFile && preview.src) return captureFrame(); // already loaded
            if (sourceUrl && ownsSourceUrl) URL.revokeObjectURL(sourceUrl);
            sourceFile = source.file || null;
            sourceUrl = source.file ? URL.createObjectURL(source.file) : source.url;
            ownsSourceUrl = Boolean(source.file);
            candidates = [];
            controls.classList.add('hidden');
            preview.classList.add('hidden');
            setStatus('Reading the video…');
            probe.src = sourceUrl;
            probe.load();
        }

        function frameLuma(ctx, w, h) {
            const data = ctx.getImageData(0, 0, w, h).data;
            let total = 0, count = 0;
            for (let i = 0; i < data.length; i += 4 * 16) { // sample every 16th pixel
                total += 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2];
                count++;
            }
            return count ? total / count : 0;
        }

        function captureFrame() {
            if (!probe.videoWidth) return;
            const scale = Math.min(1, MAX_WIDTH / probe.videoWidth);
            const w = Math.round(probe.videoWidth * scale), h = Math.round(probe.videoHeight * scale);
            if (!w || !h) return setStatus('This video has no picture to take a thumbnail from. Please choose "Upload my own image".');
            const canvas = document.createElement('canvas');
            canvas.width = w;
            canvas.height = h;
            const ctx = canvas.getContext('2d', { willReadFrequently: true });
            ctx.drawImage(probe, 0, 0, w, h);

            // Still hunting for a non-black opening frame? Try the next candidate position.
            if (candidates.length && frameLuma(ctx, w, h) < DARK_LUMA) {
                probe.currentTime = candidates.shift();
                return;
            }
            candidates = [];

            canvas.toBlob(blob => {
                if (!blob) return setStatus('Could not create a thumbnail from this video. Please choose "Upload my own image".');
                showPreview(blob);
                slider.value = probe.currentTime;
                timeLabel.textContent = formatTime(probe.currentTime);
                controls.classList.remove('hidden');
                if (mode() !== 'frame') return; // the admin switched options meanwhile
                setThumbnailFile(new File([blob], 'thumbnail.jpg', { type: 'image/jpeg' }));
                setStatus('This frame (at ' + formatTime(probe.currentTime) + ') will be the thumbnail. Drag the slider to choose a different moment.');
            }, 'image/jpeg', 0.85);
        }

        probe.addEventListener('loadedmetadata', () => {
            const d = probe.duration;
            if (!isFinite(d) || d <= 0) return setStatus('Could not read this video\'s length. Please choose "Upload my own image".');
            slider.max = d;
            durationLabel.textContent = formatTime(d);
            // Start ~10% in (skips black leaders and title fades), then step further in if dark.
            candidates = [0.25, 0.4, 0.6].map(f => f * d);
            probe.currentTime = Math.min(d * 0.1, Math.max(0, d - 0.1));
        });
        probe.addEventListener('seeked', captureFrame);
        probe.addEventListener('error', () => {
            controls.classList.add('hidden');
            setStatus('Your browser can\'t read frames from this video format (MP4 works best). Please choose "Upload my own image" instead.');
        });

        slider.addEventListener('input', () => {
            timeLabel.textContent = formatTime(Number(slider.value));
            clearTimeout(seekTimer);
            seekTimer = setTimeout(() => {
                candidates = [];
                probe.currentTime = Number(slider.value);
            }, 120);
        });

        // Switching options: show that option's panel and reset the file that will be sent.
        function applyMode() {
            const m = mode();
            picker.classList.toggle('hidden', m !== 'frame');
            uploadPanel.classList.toggle('hidden', m !== 'upload');
            if (keepPanel) keepPanel.classList.toggle('hidden', m !== 'keep');
            setThumbnailFile(null);
            if (m === 'frame') startFrames();
        }
        modeInputs.forEach(i => i.addEventListener('change', applyMode));

        // A new video (or, without one, a new trailer) gives new frames to choose from.
        function sourceChanged() { if (mode() === 'frame') startFrames(); }
        videoInput.addEventListener('change', sourceChanged);
        if (trailerInput) trailerInput.addEventListener('change', sourceChanged);

        if (mode() === 'frame') startFrames();
    })();
</script>
</body>
</html>
