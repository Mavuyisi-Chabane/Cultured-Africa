<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Cultured Africa — Your Privacy' }) %>
</head>
<body class="min-h-screen">
<%- include('partials/simple-header') %>

<main class="min-h-[80vh] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-[520px] bg-[#1e1613] rounded-[16px] shadow-xl p-8 md:p-10">
        <div class="text-center mb-8">
            <img src="/images/brand/sun.png" alt="" class="h-14 w-14 mx-auto mb-3">
            <h1 class="display-font text-2xl font-bold text-[#fcaa13] mb-2">
                <%= isUpdate ? 'Our Privacy Policy has changed' : 'Your privacy matters' %>
            </h1>
            <p class="text-[#a99a8b] text-sm leading-relaxed">
                <% if (isUpdate) { %>
                    We updated our Privacy Policy on <%= policyUpdated %>. Please review it and agree to keep using Cultured Africa.
                <% } else { %>
                    Before you continue, we need your permission to use your personal information to run your account.
                <% } %>
            </p>
        </div>

        <% if (error) { %>
            <div class="mb-6 px-4 py-3 rounded-xl bg-[#b62319]/15 text-[#ef420f] text-sm font-medium"><%= error %></div>
        <% } %>

        <div class="rounded-xl bg-[#271c17]/50 border border-[#38281f] p-5 mb-6 text-sm text-[#f7efe6] leading-relaxed">
            <p class="font-bold mb-2">What we use, and why:</p>
            <ul class="list-disc pl-5 space-y-1 text-[#a99a8b]">
                <li>Your name and email: to run and secure your account</li>
                <li>Your purchases: to give you access to the films you paid for</li>
                <li>What you watch: to resume films and show your recap</li>
                <li>Your reviews: shown to other customers with your name</li>
            </ul>
            <p class="mt-3 text-[#a99a8b]">We never sell your information. <a href="/privacy" target="_blank" rel="noopener" class="text-[#fcaa13] font-bold underline">Read the full Privacy Policy</a></p>
        </div>

        <form method="POST" action="/consent" class="space-y-5">
            <label for="privacyConsent" class="flex items-start gap-3 cursor-pointer">
                <input type="checkbox" id="privacyConsent" name="privacyConsent" value="yes"
                    class="mt-1 h-5 w-5 flex-shrink-0 accent-[#fb6b10] cursor-pointer">
                <span class="text-sm text-[#f7efe6] leading-relaxed">I have read the Privacy Policy and agree that Cultured Africa may use my personal information as described in it.</span>
            </label>
            <button type="submit" name="decision" value="accept"
                class="w-full bg-[#fb6b10] hover:bg-[#ef420f] text-[#f4ece3] font-bold py-4 rounded-xl shadow-lg shadow-[#fb6b10]/20 transition-all">
                Agree and continue
            </button>
            <button type="submit" name="decision" value="decline" formnovalidate
                class="w-full text-[#a99a8b] hover:text-[#f7efe6] text-sm font-medium py-2">
                No, log me out
            </button>
        </form>
        <p class="text-[11px] text-[#a99a8b] text-center mt-4">
            Want your data removed instead? <a href="/account" class="text-[#fcaa13] underline">Delete your account</a>.
        </p>
    </div>
</main>
</body>
</html>
