<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Cultured Africa — ' + title }) %>
</head>
<body class="min-h-screen">
<%- include('partials/simple-header') %>

<main id="main" class="min-h-[75vh] flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-[480px] text-center">
        <img src="/images/brand/sun.png" alt="" class="h-16 w-16 mx-auto mb-4 opacity-90">
        <p class="text-[#fcaa13] text-xs font-bold uppercase tracking-[0.2em] mb-2">Error <%= status %></p>
        <h1 class="display-font text-3xl font-bold text-[#f7efe6] mb-3"><%= title %></h1>
        <p class="text-[#a99a8b] leading-relaxed mb-8"><%= message %></p>
        <div class="flex flex-wrap justify-center gap-3">
            <a href="javascript:history.back()" class="px-5 py-3 rounded-xl border border-[#38281f] text-[#f7efe6] font-bold text-sm hover:border-[#fcaa13]">Go back</a>
            <a href="<%= (typeof currentAdmin !== 'undefined' && currentAdmin) ? '/admin/dashboard' : '/' %>" class="px-5 py-3 rounded-xl bg-[#fb6b10] hover:bg-[#ef420f] text-[#140d0a] font-bold text-sm">
                <%= (typeof currentAdmin !== 'undefined' && currentAdmin) ? 'Admin dashboard' : 'Home' %>
            </a>
        </div>
    </div>
</main>
</body>
</html>
