<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Cultured Africa — ' + film.title }) %>
</head>
<body class="min-h-screen">
<%- include('partials/header') %>

<main class="max-w-5xl mx-auto px-6 py-10 relative">
    <div class="absolute inset-0 pattern-overlay pointer-events-none"></div>

    <a href="/" class="text-[#8a7f73] hover:text-[#c9a84c] text-sm font-medium mb-6 inline-flex items-center gap-2"><i class="fa-solid fa-arrow-left text-xs"></i> Back to browsing</a>

    <% if (error) { %>
        <div class="mb-6 px-4 py-3 rounded-xl bg-red-50 text-red-600 text-sm font-medium"><%= error %></div>
    <% } %>

    <div class="bg-white rounded-[24px] shadow-xl shadow-black/5 overflow-hidden mb-10">
        <div class="h-72 md:h-96 relative bg-black">
            <% if (owned) { %>
                <% if (film.videoUrl && film.videoUrl.startsWith('/uploads/')) { %>
                    <video id="filmVideo" class="w-full h-full object-contain" controls poster="<%= film.thumbnailUrl %>" src="<%= film.videoUrl %>">
                        Your browser does not support video playback.
                    </video>
                    <script>
                        (function () {
                            var video = document.getElementById('filmVideo');
                            var viewId = <%= viewId ? Number(viewId) : 'null' %>;
                            var maxSeconds = 0;
                            var lastSent = 0;
                            if (!video || !viewId) return;

                            function sendProgress(seconds, completed) {
                                var payload = JSON.stringify({ viewId: viewId, progressSeconds: seconds, completed: !!completed });
                                if (navigator.sendBeacon) {
                                    navigator.sendBeacon('/film/<%= film.id %>/track-progress', new Blob([payload], { type: 'application/json' }));
                                } else {
                                    fetch('/film/<%= film.id %>/track-progress', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload, keepalive: true });
                                }
                            }

                            video.addEventListener('timeupdate', function () {
                                maxSeconds = Math.max(maxSeconds, video.currentTime);
                                var watchedMost = video.duration && (video.currentTime / video.duration) >= 0.9;
                                if (maxSeconds - lastSent >= 15 || watchedMost) {
                                    lastSent = maxSeconds;
                                    sendProgress(maxSeconds, watchedMost);
                                }
                            });
                            video.addEventListener('ended', function () { sendProgress(maxSeconds, true); });
                            window.addEventListener('pagehide', function () { sendProgress(maxSeconds, false); });
                        })();
                    </script>
                <% } else { %>
                    <img class="w-full h-full object-cover" src="<%= film.videoUrl %>" alt="<%= film.title %> playback">
                    <div class="absolute inset-0 flex items-center justify-center">
                        <div class="w-16 h-16 rounded-full bg-white/90 flex items-center justify-center shadow-lg">
                            <i class="fa-solid fa-play text-[#1a1a2e] text-xl ml-1"></i>
                        </div>
                    </div>
                <% } %>
            <% } else { %>
                <img class="w-full h-full object-cover opacity-40 blur-sm" src="<%= film.thumbnailUrl %>" alt="<%= film.title %>">
                <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-white">
                    <i class="fa-solid fa-lock text-3xl"></i>
                    <p class="text-sm font-medium">Buy this film to unlock playback</p>
                </div>
            <% } %>
        </div>

        <div class="p-8 md:p-10">
            <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                <div>
                    <h1 class="display-font text-3xl font-bold text-[#1a1a2e] mb-1"><%= film.title %></h1>
                    <p class="text-[#8a7f73] text-sm italic"><%= film.culture %> Heritage · <%= film.genre %></p>
                </div>
                <% if (owned) { %>
                    <span class="px-4 py-2 rounded-xl bg-[#2d6b6b]/10 text-[#2d6b6b] text-sm font-bold flex items-center gap-2"><i class="fa-solid fa-circle-check"></i> Ready to watch</span>
                <% } else if (paystackPublicKey) { %>
                    <div>
                        <button type="button" id="paystackBuyBtn" class="bg-[#c9a84c] hover:bg-[#b8973d] text-white px-8 py-3 rounded-xl font-bold text-sm shadow-md shadow-[#c9a84c]/20 transition-all flex items-center gap-2">
                            <i class="fa-solid fa-lock text-xs"></i> Buy R<%= film.price.toFixed(0) %>
                        </button>
                        <p class="text-[10px] text-[#8a7f73] mt-2 text-right">Secured by Paystack (test mode)</p>
                    </div>
                    <form id="paystackBuyForm" action="/film/<%= film.id %>/buy" method="POST" class="hidden">
                        <input type="hidden" name="reference" id="paystackReference">
                    </form>
                    <script src="https://js.paystack.co/v1/inline.js"></script>
                    <script>
                        document.getElementById('paystackBuyBtn').addEventListener('click', function () {
                            var handler = PaystackPop.setup({
                                key: '<%= paystackPublicKey %>',
                                email: '<%= currentUser.email %>',
                                amount: <%= Math.round(film.price * 100) %>,
                                currency: '<%= paystackCurrency %>',
                                ref: 'HS-<%= film.id %>-' + Date.now(),
                                metadata: { filmId: <%= film.id %>, filmTitle: <%- JSON.stringify(film.title) %> },
                                callback: function (response) {
                                    document.getElementById('paystackReference').value = response.reference;
                                    document.getElementById('paystackBuyForm').submit();
                                },
                                onClose: function () {}
                            });
                            handler.openIframe();
                        });
                    </script>
                <% } else { %>
                    <span class="px-4 py-2 rounded-xl bg-red-50 text-red-600 text-xs font-bold max-w-xs text-right">
                        Payments are not configured yet. Add Paystack test keys to webapp/.env.
                    </span>
                <% } %>
            </div>

            <div class="flex items-center gap-1 mb-6 text-[#c9a84c]">
                <% const full = Math.floor(film.rating); const half = film.rating - full >= 0.5; %>
                <% for (let i = 0; i < 5; i++) { %>
                    <% if (i < full) { %><i class="fa-solid fa-star text-sm"></i>
                    <% } else if (i === full && half) { %><i class="fa-solid fa-star-half-stroke text-sm"></i>
                    <% } else { %><i class="fa-regular fa-star text-sm"></i><% } %>
                <% } %>
                <span class="text-[#8a7f73] text-sm ml-1 font-normal">(<%= film.rating.toFixed(1) %>)</span>
            </div>

            <p class="text-[#2d2d2d] leading-relaxed"><%= film.description %></p>
        </div>
    </div>

    <div class="bg-white rounded-[24px] shadow-xl shadow-black/5 p-8 md:p-10 mb-10">
        <h2 class="text-xl font-bold text-[#1a1a2e] mb-6">Leave a Review</h2>

        <form action="/film/<%= film.id %>/review" method="POST" class="space-y-4">
            <div>
                <label class="block text-xs font-bold uppercase tracking-widest text-[#2d2d2d] mb-2">Rating</label>
                <select name="rating" class="w-full px-4 py-3 bg-[#f5f0e8]/50 border border-[#e8e0d5] rounded-xl">
                    <option value="5">5 - Excellent</option>
                    <option value="4">4 - Great</option>
                    <option value="3">3 - Good</option>
                    <option value="2">2 - Fair</option>
                    <option value="1">1 - Poor</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold uppercase tracking-widest text-[#2d2d2d] mb-2">Comment</label>
                <textarea name="comment" rows="3" placeholder="Share your thoughts..." class="w-full px-4 py-3 bg-[#f5f0e8]/50 border border-[#e8e0d5] rounded-xl resize-none"></textarea>
            </div>
            <button type="submit" class="bg-[#1a1a2e] hover:bg-[#252542] text-[#c9a84c] font-bold px-6 py-3 rounded-xl transition-all border border-[#c9a84c]/30">Submit Review</button>
        </form>
    </div>

    <div class="mb-10">
        <h2 class="text-xl font-bold text-[#1a1a2e] mb-6">Reviews (<%= filmReviews.length %>)</h2>
        <% if (filmReviews.length === 0) { %>
            <p class="text-[#8a7f73] text-sm">No reviews yet — be the first to share your thoughts.</p>
        <% } %>
        <div class="space-y-4">
            <% filmReviews.forEach(r => { %>
                <div class="bg-white rounded-2xl border border-[#e8e0d5] p-6">
                    <div class="flex items-center justify-between mb-2">
                        <span class="font-bold text-[#1a1a2e] text-sm"><%= r.user ? r.user.fullName : 'Unknown' %></span>
                        <div class="text-[#c9a84c] text-xs">
                            <% for (let i = 0; i < 5; i++) { %><i class="fa-solid fa-star<%= i < r.rating ? '' : ' opacity-20' %>"></i><% } %>
                        </div>
                    </div>
                    <p class="text-[#2d2d2d] text-sm mb-2"><%= r.comment %></p>
                    <% if (r.adminReply) { %>
                        <div class="mt-3 pl-4 border-l-2 border-[#c9a84c]/40">
                            <p class="text-[10px] font-bold uppercase tracking-widest text-[#c9a84c] mb-1">Cultured Africa Team</p>
                            <p class="text-[#8a7f73] text-sm"><%= r.adminReply %></p>
                        </div>
                    <% } %>
                </div>
            <% }) %>
        </div>
    </div>

    <%- include('partials/footer') %>
</main>
</body>
</html>
