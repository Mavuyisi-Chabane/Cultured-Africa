<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Cultured Africa — ' + film.title }) %>
</head>
<body class="min-h-screen">
<%- include('partials/header') %>

<main class="max-w-5xl mx-auto px-6 py-10 relative">
    <div class="absolute inset-0 pattern-overlay pointer-events-none"></div>

    <a href="<%= currentUser ? '/' : '/films' %>" class="text-[#a99a8b] hover:text-[#fcaa13] text-sm font-medium mb-6 inline-flex items-center gap-2"><i class="fa-solid fa-arrow-left text-xs"></i> Back to browsing</a>

    <% if (error) { %>
        <div class="mb-6 px-4 py-3 rounded-xl bg-[#b62319]/15 text-[#ef420f] text-sm font-medium"><%= error %></div>
    <% } %>

    <div class="bg-[#1e1613] rounded-[24px] shadow-xl shadow-black/5 overflow-hidden mb-10">
        <div class="h-72 md:h-96 relative bg-black">
            <% if (owned) { %>
                <% if (film.videoUrl && film.videoUrl.startsWith('/uploads/')) { %>
                    <%# Streams through the access-checked route, never the raw /uploads file. %>
                    <%
                        // One device at a time: the video only loads after this tab claims playback.
                        const pt = typeof playbackToken !== 'undefined' ? playbackToken : null;
                    %>
                    <video id="filmVideo" class="w-full h-full object-contain" controls controlsList="nodownload" disablePictureInPicture oncontextmenu="return false;" preload="none" poster="<%= film.thumbnailUrl %>" data-stream-src="/film/<%= film.id %>/stream?pt=<%= pt || '' %>">
                        Your browser does not support video playback.
                    </video>
                    <div id="playOverlay" class="absolute inset-0 flex items-center justify-center bg-black/40">
                        <% if (pt) { %>
                            <button type="button" id="startPlayback" class="w-20 h-20 rounded-full bg-[#fb6b10] hover:bg-[#ef420f] text-[#f4ece3] shadow-xl flex items-center justify-center" aria-label="Play <%= film.title %>">
                                <i class="fa-solid fa-play text-2xl ml-1"></i>
                            </button>
                        <% } else { %>
                            <a href="/film/<%= film.id %>" class="w-20 h-20 rounded-full bg-[#fb6b10] text-[#f4ece3] shadow-xl flex items-center justify-center" aria-label="Play <%= film.title %>"><i class="fa-solid fa-play text-2xl ml-1"></i></a>
                        <% } %>
                    </div>
                    <div id="otherDeviceOverlay" class="absolute inset-0 hidden flex-col items-center justify-center gap-4 bg-black/85 text-center px-6" role="alert">
                        <i class="fa-solid fa-tv text-3xl text-[#fcaa13]"></i>
                        <p class="text-[#f7efe6] font-bold text-lg">You're watching on another device</p>
                        <p class="text-[#a99a8b] text-sm max-w-sm">Your account can play films on one device at a time, so playback stopped here when it started somewhere else.</p>
                        <button type="button" id="watchHere" class="bg-[#fb6b10] hover:bg-[#ef420f] text-[#f4ece3] px-6 py-3 rounded-xl font-bold text-sm">Watch here instead</button>
                    </div>
                    <script>
                        (function () {
                            var video = document.getElementById('filmVideo');
                            var viewId = <%= viewId ? Number(viewId) : 'null' %>;
                            var resumeSeconds = <%= Number(resumeSeconds) || 0 %>;
                            var resumeCompleted = <%= resumeCompleted ? 'true' : 'false' %>;
                            var maxSeconds = resumeSeconds;
                            var lastSent = 0;
                            var playbackToken = <%- JSON.stringify(typeof playbackToken !== 'undefined' ? playbackToken : null) %>;
                            var csrf = <%- JSON.stringify(csrfToken) %>;
                            var claimed = false;
                            var playOverlay = document.getElementById('playOverlay');
                            var otherOverlay = document.getElementById('otherDeviceOverlay');
                            if (!video || !viewId || !playbackToken) return;

                            function showOtherDevice() {
                                claimed = false;
                                video.pause();
                                otherOverlay.classList.remove('hidden');
                                otherOverlay.classList.add('flex');
                            }

                            // Claim this tab as the account's one active device, then start loading.
                            function claimAndPlay() {
                                fetch('/film/<%= film.id %>/playback/claim', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
                                    body: JSON.stringify({ playbackToken: playbackToken })
                                }).then(function (r) { return r.ok ? r.json() : { ok: false }; }).then(function (data) {
                                    if (!data.ok) return;
                                    claimed = true;
                                    playOverlay.classList.add('hidden');
                                    otherOverlay.classList.add('hidden');
                                    otherOverlay.classList.remove('flex');
                                    var at = video.currentTime;
                                    if (!video.getAttribute('src')) {
                                        video.src = video.getAttribute('data-stream-src');
                                    } else {
                                        // Reload so the browser re-requests the video now that it's allowed.
                                        video.load();
                                        if (at > 0) video.addEventListener('loadedmetadata', function () { video.currentTime = at; }, { once: true });
                                    }
                                    var playing = video.play();
                                    if (playing && playing.catch) playing.catch(function () {});
                                });
                            }
                            document.getElementById('startPlayback').addEventListener('click', claimAndPlay);
                            document.getElementById('watchHere').addEventListener('click', claimAndPlay);
                            // The stream refuses this tab once another device has taken over.
                            video.addEventListener('error', function () { if (video.getAttribute('src')) showOtherDevice(); });
                            video.addEventListener('play', function () { if (!claimed) { video.pause(); claimAndPlay(); } });

                            if (!resumeCompleted && resumeSeconds > 5) {
                                video.addEventListener('loadedmetadata', function () {
                                    if (!video.duration || resumeSeconds < video.duration - 10) {
                                        video.currentTime = resumeSeconds;
                                    }
                                }, { once: true });
                            }

                            // Saves progress and doubles as the heartbeat that checks this is
                            // still the account's active device. On leaving the page, a beacon
                            // (which can't read a reply) just saves the final position.
                            function sendProgress(seconds, completed, leaving) {
                                var payload = JSON.stringify({ viewId: viewId, progressSeconds: seconds, completed: !!completed, playbackToken: playbackToken, _csrf: csrf });
                                if (leaving && navigator.sendBeacon) {
                                    navigator.sendBeacon('/film/<%= film.id %>/track-progress', new Blob([payload], { type: 'application/json' }));
                                    return;
                                }
                                fetch('/film/<%= film.id %>/track-progress', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload, keepalive: true })
                                    .then(function (r) { return r.ok ? r.json() : null; })
                                    .then(function (data) { if (data && data.active === false && claimed) showOtherDevice(); })
                                    .catch(function () {});
                            }

                            video.addEventListener('timeupdate', function () {
                                maxSeconds = Math.max(maxSeconds, video.currentTime);
                                var watchedMost = video.duration && (video.currentTime / video.duration) >= 0.9;
                                if (maxSeconds - lastSent >= 15 || watchedMost) {
                                    lastSent = maxSeconds;
                                    sendProgress(maxSeconds, watchedMost);
                                }
                            });
                            video.addEventListener('ended', function () { sendProgress(maxSeconds, true); });
                            window.addEventListener('pagehide', function () { sendProgress(maxSeconds, false, true); });
                        })();
                    </script>
                <% } else { %>
                    <img class="w-full h-full object-cover" src="<%= film.videoUrl %>" alt="<%= film.title %> playback">
                    <div class="absolute inset-0 flex items-center justify-center">
                        <div class="w-16 h-16 rounded-full bg-[#1e1613]/90 flex items-center justify-center shadow-lg">
                            <i class="fa-solid fa-play text-[#f7efe6] text-xl ml-1"></i>
                        </div>
                    </div>
                <% } %>
            <% } else if (film.comingSoon) { %>
                <img class="w-full h-full object-cover opacity-50" src="<%= film.thumbnailUrl %>" alt="<%= film.title %>">
                <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 text-[#f4ece3] bg-black/30">
                    <span class="px-3 py-1 rounded-full bg-[#fcaa13] text-[#140d0a] text-xs font-bold uppercase tracking-widest">Coming soon</span>
                    <p class="text-sm font-medium">The full film isn't available yet.</p>
                    <% if (film.trailerUrl) { %>
                        <button type="button" data-trailer-src="<%= film.trailerUrl %>" data-trailer-title="<%= film.title %>"
                            class="inline-flex items-center gap-2 bg-[#fb6b10] hover:bg-[#ef420f] text-[#f4ece3] px-6 py-3 rounded-xl font-bold text-sm shadow-md transition-all">
                            <i class="fa-solid fa-play text-xs"></i> Watch the trailer
                        </button>
                    <% } %>
                </div>
            <% } else { %>
                <img class="w-full h-full object-cover opacity-40 blur-sm" src="<%= film.thumbnailUrl %>" alt="<%= film.title %>">
                <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-[#f4ece3]">
                    <i class="fa-solid fa-lock text-3xl"></i>
                    <% if (!currentUser) { %>
                        <p class="text-sm font-medium"><%= film.price === 0 ? 'This film is free. Log in or create a free account to watch it.' : 'Log in to buy and watch this film.' %></p>
                        <a href="/login?next=/film/<%= film.id %>" class="mt-1 bg-[#fb6b10] hover:bg-[#ef420f] text-[#f4ece3] px-6 py-3 rounded-xl font-bold text-sm shadow-md"><%= film.price === 0 ? 'Log in to watch free' : 'Log in to buy' %></a>
                    <% } else { %>
                        <p class="text-sm font-medium"><%= access ? 'Your ' + accessMonths + '-month access has ended — buy again to keep watching' : 'Buy this film to unlock playback' %></p>
                    <% } %>
                </div>
            <% } %>
        </div>

        <div class="p-8 md:p-10">
            <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                <div>
                    <h1 class="display-font text-3xl font-bold text-[#f7efe6] mb-1"><%= film.title %></h1>
                    <p class="text-[#a99a8b] text-sm italic"><%= film.culture %> Heritage · <%= film.genre %></p>
                    <div class="mt-4"><%- include('partials/age-rating', { classification: film.classification, detailed: true }) %></div>
                    <% if (film.trailerUrl) { %>
                        <button type="button" data-trailer-src="<%= film.trailerUrl %>" data-trailer-title="<%= film.title %>"
                            class="mt-4 inline-flex items-center gap-2 border border-[#fcaa13] text-[#fcaa13] hover:bg-[#fcaa13]/10 px-5 py-2.5 rounded-xl font-bold text-sm transition-all">
                            <i class="fa-solid fa-play text-xs"></i> Watch trailer
                        </button>
                    <% } %>
                </div>
                <% const formatAccessDate = d => d.toLocaleDateString('en-ZA', { day: 'numeric', month: 'long', year: 'numeric' }); %>
                <% if (film.comingSoon) { %>
                    <div class="text-right">
                        <span class="px-4 py-2 rounded-xl bg-[#fcaa13]/10 text-[#fcaa13] text-sm font-bold inline-flex items-center gap-2"><i class="fa-solid fa-clock"></i> Coming soon</span>
                        <p class="text-xs mt-2 text-[#a99a8b]">Available to buy once the full film is released<%= film.price > 0 ? ' · R' + film.price.toFixed(0) : '' %>.</p>
                    </div>
                <% } else if (owned) { %>
                    <div class="text-right">
                        <span class="px-4 py-2 rounded-xl bg-[#9db183]/10 text-[#9db183] text-sm font-bold inline-flex items-center gap-2"><i class="fa-solid fa-circle-check"></i> Ready to watch</span>
                        <% if (access && access.active) { %>
                            <% const daysLeft = Math.ceil((access.expiresAt - Date.now()) / 86400000); %>
                            <p class="text-xs mt-2 <%= daysLeft <= 14 ? 'text-[#fcaa13] font-bold' : 'text-[#a99a8b]' %>">
                                <i class="fa-regular fa-clock mr-1"></i>Access until <%= formatAccessDate(access.expiresAt) %><%= daysLeft <= 14 ? ' — ' + daysLeft + ' day' + (daysLeft === 1 ? '' : 's') + ' left' : '' %>
                            </p>
                        <% } %>
                    </div>
                <% } else if (!currentUser) { %>
                    <div class="text-right">
                        <a href="/login?next=/film/<%= film.id %>" class="inline-flex items-center gap-2 bg-[#fb6b10] hover:bg-[#ef420f] text-[#f4ece3] px-8 py-3 rounded-xl font-bold text-sm shadow-md shadow-[#fb6b10]/20 transition-all">
                            <i class="fa-solid fa-right-to-bracket text-xs"></i> <%= film.price === 0 ? 'Log in to watch free' : 'Log in to buy R' + film.price.toFixed(0) %>
                        </a>
                        <p class="text-xs text-[#a99a8b] mt-2">New here? <a href="/register?next=/film/<%= film.id %>" class="text-[#fcaa13] font-bold underline">Create a free account</a>. We'll bring you back to this film.</p>
                        <% if (film.price > 0) { %>
                            <p class="text-[11px] text-[#a99a8b] mt-2">Once-off R<%= film.price.toFixed(0) %> · <%= accessMonths %> months' access · <a href="/purchase-terms" target="_blank" rel="noopener" class="underline">Pricing &amp; refunds</a></p>
                        <% } %>
                    </div>
                <% } else if (paystackPublicKey) { %>
                    <div class="text-right">
                        <% if (access) { %>
                            <p class="text-xs text-[#fcaa13] font-bold mb-2"><i class="fa-regular fa-clock mr-1"></i>Your access expired on <%= formatAccessDate(access.expiresAt) %>.</p>
                        <% } %>
                        <button type="button" id="paystackBuyBtn" class="ml-auto bg-[#fb6b10] hover:bg-[#ef420f] text-[#f4ece3] px-8 py-3 rounded-xl font-bold text-sm shadow-md shadow-[#fb6b10]/20 transition-all flex items-center gap-2">
                            <i class="fa-solid fa-lock text-xs"></i> <%= access ? 'Buy again' : 'Buy' %> R<%= film.price.toFixed(0) %>
                        </button>
                        <ul class="text-[11px] text-[#a99a8b] mt-3 space-y-1 text-right">
                            <li>Once-off payment of R<%= film.price.toFixed(0) %>. No subscription.</li>
                            <li>Watch as often as you like for <%= accessMonths %> months.</li>
                            <li>Full refund within <%= purchaseTerms.REFUND_DAYS %> days if you've watched no more than <%= purchaseTerms.REFUND_MAX_MINUTES_WATCHED %> minutes.</li>
                            <li>By buying you agree to our <a href="/purchase-terms" target="_blank" rel="noopener" class="text-[#fcaa13] underline">Pricing, Billing and Cancellation Policy</a>.</li>
                            <li>Secured by Paystack<%= paystackPublicKey.startsWith('pk_test_') ? ' (test mode)' : '' %></li>
                        </ul>
                    </div>
                    <form id="paystackBuyForm" action="/film/<%= film.id %>/buy" method="POST" class="hidden">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="reference" id="paystackReference">
                    </form>
                    <script src="https://js.paystack.co/v1/inline.js"></script>
                    <script>
                        document.getElementById('paystackBuyBtn').addEventListener('click', function () {
                            var handler = PaystackPop.setup({
                                key: '<%= paystackPublicKey %>',
                                email: '<%= currentUser.email %>',
                                amount: <%= Math.round(film.price * 100) %>,
                                currency: '<%= paystackCurrency %>',
                                ref: 'HS-<%= film.id %>-' + Date.now(),
                                metadata: { filmId: <%= film.id %>, filmTitle: <%- JSON.stringify(film.title) %> },
                                callback: function (response) {
                                    document.getElementById('paystackReference').value = response.reference;
                                    document.getElementById('paystackBuyForm').submit();
                                },
                                onClose: function () {}
                            });
                            handler.openIframe();
                        });
                    </script>
                <% } else { %>
                    <span class="px-4 py-2 rounded-xl bg-[#b62319]/15 text-[#ef420f] text-xs font-bold max-w-xs text-right">
                        Purchases are temporarily unavailable. Please try again later.
                    </span>
                <% } %>
            </div>

            <div class="flex items-center gap-1 mb-6 text-[#fcaa13]">
                <% const full = Math.floor(film.rating); const half = film.rating - full >= 0.5; %>
                <% for (let i = 0; i < 5; i++) { %>
                    <% if (i < full) { %><i class="fa-solid fa-star text-sm"></i>
                    <% } else if (i === full && half) { %><i class="fa-solid fa-star-half-stroke text-sm"></i>
                    <% } else { %><i class="fa-regular fa-star text-sm"></i><% } %>
                <% } %>
                <span class="text-[#a99a8b] text-sm ml-1 font-normal">(<%= film.rating.toFixed(1) %>)</span>
            </div>

            <p class="text-[#f7efe6] leading-relaxed"><%= film.description %></p>
        </div>
    </div>

    <div class="bg-[#1e1613] rounded-[24px] shadow-xl shadow-black/5 p-8 md:p-10 mb-10">
        <h2 class="text-xl font-bold text-[#f7efe6] mb-6">Leave a Review</h2>

        <% if (canReview) { %>
            <form action="/film/<%= film.id %>/review" method="POST" class="space-y-4">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-widest text-[#f7efe6] mb-2">Rating <span class="text-[#a99a8b] normal-case font-normal">(optional)</span></label>
                    <select name="rating" class="w-full px-4 py-3 bg-[#271c17]/50 border border-[#38281f] rounded-xl">
                        <option value="">No rating</option>
                        <option value="5">5 - Excellent</option>
                        <option value="4">4 - Great</option>
                        <option value="3">3 - Good</option>
                        <option value="2">2 - Fair</option>
                        <option value="1">1 - Poor</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-widest text-[#f7efe6] mb-2">Comment <span class="text-[#a99a8b] normal-case font-normal">(optional)</span></label>
                    <textarea name="comment" rows="3" placeholder="Share your thoughts..." class="w-full px-4 py-3 bg-[#271c17]/50 border border-[#38281f] rounded-xl resize-none"></textarea>
                </div>
                <p class="text-[#a99a8b] text-xs">Leave a rating, a comment, or both.</p>
                <button type="submit" class="bg-[#0f0a08] hover:bg-[#0a0605] text-[#fcaa13] font-bold px-6 py-3 rounded-xl transition-all border border-[#fcaa13]/30">Submit Review</button>
            </form>
        <% } else { %>
            <div class="bg-[#271c17]/50 border border-[#38281f] rounded-xl px-6 py-8 text-center">
                <i class="fa-solid fa-lock text-[#a99a8b] text-xl mb-3"></i>
                <p class="text-[#f7efe6] text-sm font-medium"><%= currentUser ? 'Buy this film to leave a review.' : 'Log in and buy this film to leave a review.' %></p>
                <p class="text-[#a99a8b] text-xs mt-1">Reviews are only open to viewers who have bought the film.</p>
            </div>
        <% } %>
    </div>

    <div class="mb-10">
        <h2 class="text-xl font-bold text-[#f7efe6] mb-6">Reviews (<%= filmReviews.length %>)</h2>
        <% if (filmReviews.length === 0) { %>
            <p class="text-[#a99a8b] text-sm">No reviews yet — be the first to share your thoughts.</p>
        <% } %>
        <div class="space-y-4">
            <% filmReviews.forEach(r => { %>
                <div class="bg-[#1e1613] rounded-2xl border border-[#38281f] p-6">
                    <div class="flex items-center justify-between mb-2">
                        <span class="font-bold text-[#f7efe6] text-sm"><%= r.user ? r.user.fullName : 'Unknown' %></span>
                        <% if (r.rating) { %>
                            <div class="text-[#fcaa13] text-xs">
                                <% for (let i = 0; i < 5; i++) { %><i class="fa-solid fa-star<%= i < r.rating ? '' : ' opacity-20' %>"></i><% } %>
                            </div>
                        <% } else { %>
                            <span class="text-[#a99a8b] text-[10px] uppercase tracking-widest font-bold">No rating</span>
                        <% } %>
                    </div>
                    <% if (r.comment) { %>
                        <p class="text-[#f7efe6] text-sm mb-2"><%= r.comment %></p>
                    <% } %>
                    <% if (r.adminReply) { %>
                        <div class="mt-3 pl-4 border-l-2 border-[#fcaa13]/40">
                            <p class="text-[10px] font-bold uppercase tracking-widest text-[#fcaa13] mb-1">Cultured Africa Team</p>
                            <p class="text-[#a99a8b] text-sm"><%= r.adminReply %></p>
                        </div>
                    <% } %>
                </div>
            <% }) %>
        </div>
    </div>

    <%- include('partials/footer') %>
<%- include('partials/trailer-modal') %>
</main>
</body>
</html>
