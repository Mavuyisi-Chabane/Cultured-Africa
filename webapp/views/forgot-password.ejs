<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Cultured Africa — Forgot Password' }) %>
</head>
<body class="min-h-screen flex items-center justify-center p-4 py-10 pattern-bg relative overflow-x-hidden">
    <div class="absolute -top-24 -left-24 w-96 h-96 opacity-10 pointer-events-none">
        <img class="w-full h-full object-contain" src="https://storage.googleapis.com/uxpilot-auth.appspot.com/gen_ca850ca978_d4ec892f98137ca1.png" alt="">
    </div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 opacity-10 pointer-events-none">
        <img class="w-full h-full object-contain" src="https://storage.googleapis.com/uxpilot-auth.appspot.com/gen_a0803f0285_0b097c705f62f8d3.png" alt="">
    </div>

    <div class="w-full max-w-[450px] bg-[#1e1613] rounded-[16px] shadow-xl p-8 md:p-10 z-10">
        <% if (submitted) { %>
            <div class="text-center">
                <div class="w-16 h-16 rounded-full bg-[#271c17] flex items-center justify-center text-[#fcaa13] mx-auto mb-6">
                    <i class="fa-solid fa-envelope-circle-check text-2xl"></i>
                </div>
                <h1 class="display-font text-2xl font-bold text-[#f7efe6] mb-3">Check Your Email</h1>
                <p class="text-[#a99a8b] text-sm leading-relaxed mb-8">
                    If an account exists for <span class="font-bold text-[#f7efe6]"><%= email %></span>, we've sent a password reset link.
                    It expires in <span class="font-bold text-[#f7efe6]">30 minutes</span>.
                </p>
                <a href="/login" class="inline-block bg-[#fb6b10] hover:bg-[#ef420f] text-[#f4ece3] font-bold py-3 px-8 rounded-xl shadow-lg shadow-[#fb6b10]/20 transition-all">
                    Back to Login
                </a>
            </div>
        <% } else { %>
            <div class="text-center mb-10">
                <h1 class="display-font text-3xl font-bold text-[#fcaa13] mb-2">Forgot Password?</h1>
                <p class="text-[#a99a8b] text-sm">Enter your email and we'll send you a reset link.</p>
            </div>

            <% if (error) { %>
                <div class="mb-6 px-4 py-3 rounded-xl bg-[#b62319]/15 text-[#ef420f] text-sm font-medium"><%= error %></div>
            <% } %>

            <form id="forgot-password-form" class="space-y-6" method="POST" action="/forgot-password">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-[#f7efe6] mb-2" for="email">Email Address</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-[#a99a8b]">
                            <i class="fa-solid fa-envelope text-sm"></i>
                        </span>
                        <input type="email" id="email" name="email" placeholder="john@example.com" value="<%= email %>" required
                            class="w-full pl-11 pr-4 py-3 border border-[#38281f] rounded-xl focus:ring-2 focus:ring-[#fcaa13] focus:border-transparent outline-none transition-all text-[#f4ece3] bg-[#271c17]/50">
                    </div>
                </div>

                <button id="forgot-password-submit" type="submit"
                    class="w-full bg-[#fb6b10] hover:bg-[#ef420f] text-[#f4ece3] font-bold py-4 rounded-xl shadow-lg shadow-[#fb6b10]/20 transform transition-all active:scale-[0.98] flex items-center justify-center gap-2 disabled:opacity-70">
                    <span id="forgot-password-submit-label">Send Reset Link</span>
                </button>
            </form>

            <div class="mt-8 pt-8 border-t border-[#38281f] text-center">
                <p class="text-[#a99a8b] text-sm">
                    Remembered your password?
                    <a href="/login" class="text-[#fcaa13] font-bold hover:underline ml-1">Back to Login</a>
                </p>
            </div>
        <% } %>
    </div>

    <div class="absolute inset-0 z-0 opacity-20 pointer-events-none mix-blend-multiply">
        <img class="w-full h-full object-cover" src="https://storage.googleapis.com/uxpilot-auth.appspot.com/gen_5a943a1ed8_2798cfb2407b212d.png" alt="">
    </div>

    <script>
        (function () {
            var form = document.getElementById('forgot-password-form');
            var submitBtn = document.getElementById('forgot-password-submit');
            var label = document.getElementById('forgot-password-submit-label');
            if (!form || !submitBtn || !label) return;

            form.addEventListener('submit', function () {
                submitBtn.disabled = true;
                label.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';
            });
        })();
    </script>
</body>
</html>
