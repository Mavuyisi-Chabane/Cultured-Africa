<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Cultured Africa — Home' }) %>
</head>
<body class="min-h-screen">
<%- include('partials/header') %>

<main class="max-w-7xl mx-auto px-6 py-8 relative">
    <div class="absolute inset-0 pattern-overlay pointer-events-none"></div>

    <div class="mb-8">
        <h1 class="text-2xl md:text-3xl font-bold text-[#f7efe6] mb-1">Welcome back, <%= currentUser.fullName %></h1>
        <p class="text-[#a99a8b] text-sm">Continue exploring the rich heritage of Cultured Africa.</p>
    </div>

    <%
      // Builds a home URL from the current filters plus any overrides, dropping defaults
      // so links stay short (e.g. "/?q=drum" rather than "/?q=drum&culture=All&...").
      const defaults = { q: '', culture: 'All', price: 'all', sort: 'newest' };
      const homeUrl = overrides => {
        const merged = { ...filters, ...overrides };
        const params = new URLSearchParams();
        Object.keys(defaults).forEach(k => { if (merged[k] !== defaults[k]) params.set(k, merged[k]); });
        const qs = params.toString();
        return qs ? '/?' + qs : '/';
      };
      const isFiltered = filters.q || filters.culture !== 'All' || filters.price !== 'all';
      const selectCls = 'bg-[#1e1613] border border-[#38281f] rounded-full px-4 py-2.5 text-sm font-bold text-[#f7efe6] cursor-pointer focus:border-[#fcaa13]';
    %>

    <form method="get" action="/" id="film-filters" role="search" class="mb-6 flex flex-col md:flex-row gap-3 md:items-center">
        <div class="relative flex-1">
            <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-[#a99a8b] text-sm pointer-events-none"></i>
            <input type="search" name="q" value="<%= filters.q %>" maxlength="100" autocomplete="off"
                   placeholder="Search films by title, culture, genre or description…" aria-label="Search films"
                   class="w-full pl-11 pr-4 py-3 bg-[#1e1613] border border-[#38281f] rounded-full text-sm text-[#f7efe6] placeholder-[#a99a8b]/70 focus:border-[#fcaa13] transition-all">
        </div>
        <% if (filters.culture !== 'All') { %><input type="hidden" name="culture" value="<%= filters.culture %>"><% } %>
        <div class="flex gap-3 flex-wrap">
            <label class="sr-only" for="price-filter">Price</label>
            <select name="price" id="price-filter" class="<%= selectCls %>">
                <% priceOptions.forEach(o => { %>
                    <option value="<%= o.value %>" <%= filters.price === o.value ? 'selected' : '' %>><%= o.label %></option>
                <% }) %>
            </select>
            <label class="sr-only" for="sort-filter">Sort by</label>
            <select name="sort" id="sort-filter" class="<%= selectCls %>">
                <% sortOptions.forEach(o => { %>
                    <option value="<%= o.value %>" <%= filters.sort === o.value ? 'selected' : '' %>>Sort: <%= o.label %></option>
                <% }) %>
            </select>
            <button type="submit" class="bg-[#fb6b10] hover:bg-[#ef420f] text-[#f4ece3] px-6 py-2.5 rounded-full font-bold text-sm shadow-md transition-all">Search</button>
        </div>
    </form>

    <div class="mb-6 overflow-x-auto">
        <div class="flex items-center gap-3 min-w-max pb-2">
            <a href="<%= homeUrl({ culture: 'All' }) %>" class="px-6 py-2 rounded-full text-sm font-bold shadow-md transition-all <%= filters.culture === 'All' ? 'bg-[#fb6b10] text-[#f4ece3]' : 'border border-[#38281f] bg-[#1e1613] text-[#f7efe6] hover:border-[#fcaa13]' %>">All</a>
            <% cultures.forEach(culture => { %>
                <a href="<%= homeUrl({ culture }) %>" class="px-6 py-2 rounded-full text-sm font-medium shadow-md transition-all <%= filters.culture === culture ? 'bg-[#fb6b10] text-[#f4ece3] font-bold' : 'border border-[#38281f] bg-[#1e1613] text-[#f7efe6] hover:border-[#fcaa13]' %>"><%= culture %></a>
            <% }) %>
        </div>
    </div>

    <div class="mb-8 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-[#a99a8b]">
        <span>
            <%= films.length %> film<%= films.length === 1 ? '' : 's' %>
            <% if (filters.q) { %> matching “<span class="text-[#f7efe6] font-bold"><%= filters.q %></span>”<% } %>
            <% if (filters.culture !== 'All') { %> in <span class="text-[#f7efe6] font-bold"><%= filters.culture %></span><% } %>
            <% if (filters.price !== 'all') { %> · <%= filters.price === 'free' ? 'free only' : 'paid only' %><% } %>
        </span>
        <% if (isFiltered) { %>
            <a href="<%= homeUrl({ q: '', culture: 'All', price: 'all' }) %>" class="text-[#fcaa13] font-bold hover:underline">Clear filters</a>
        <% } %>
    </div>

    <div id="film-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% if (films.length === 0) { %>
            <div class="col-span-full text-center py-16">
                <i class="fa-solid fa-film text-3xl text-[#38281f] mb-4"></i>
                <p class="text-[#f7efe6] font-bold mb-1"><%= isFiltered ? 'No films match your search.' : 'No films available yet.' %></p>
                <% if (isFiltered) { %>
                    <p class="text-[#a99a8b] text-sm">Try a different word, another culture, or <a href="/" class="text-[#fcaa13] font-bold hover:underline">browse all films</a>.</p>
                <% } %>
            </div>
        <% } %>
        <% films.forEach(film => { %>
            <a href="/film/<%= film.id %>" class="bg-[#1e1613] rounded-[16px] shadow-sm border border-[#38281f] overflow-hidden group hover:shadow-xl transition-all duration-300">
                <div class="h-56 overflow-hidden relative">
                    <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="<%= film.thumbnailUrl %>" alt="<%= film.title %>" />
                    <div class="absolute top-4 left-4"><%- include('partials/age-rating', { classification: film.classification }) %></div>
                    <% if (film.price > 0) { %>
                        <div class="absolute top-4 right-4 bg-[#1e1613]/90 backdrop-blur px-2 py-1 rounded text-[10px] font-bold text-[#f7efe6] uppercase tracking-widest">Premium</div>
                    <% } %>
                </div>
                <div class="p-6">
                    <h3 class="text-xl font-bold text-[#f7efe6] mb-1"><%= film.title %></h3>
                    <p class="text-[#a99a8b] text-xs font-medium mb-4 italic"><%= film.culture %> Heritage · <%= film.genre %></p>

                    <div class="flex items-center gap-1 mb-4 text-[#fcaa13]">
                        <% const full = Math.floor(film.rating); const half = film.rating - full >= 0.5; %>
                        <% for (let i = 0; i < 5; i++) { %>
                            <% if (i < full) { %>
                                <i class="fa-solid fa-star text-xs"></i>
                            <% } else if (i === full && half) { %>
                                <i class="fa-solid fa-star-half-stroke text-xs"></i>
                            <% } else { %>
                                <i class="fa-regular fa-star text-xs"></i>
                            <% } %>
                        <% } %>
                        <span class="text-[#a99a8b] text-xs ml-1 font-normal">(<%= film.rating.toFixed(1) %>)</span>
                        <span class="text-[#a99a8b] text-xs ml-auto font-normal"><i class="fa-solid fa-eye mr-1"></i><%= film.watchCount %> view<%= film.watchCount === 1 ? '' : 's' %></span>
                    </div>

                    <div class="flex items-center justify-between mt-6 pt-4 border-t border-[#38281f]">
                        <span class="<%= film.price > 0 && !film.owned ? 'text-[#9db183]' : 'text-[#fcaa13]' %> font-bold text-lg leading-tight">
                            <%= film.price === 0 ? 'Free' : (film.owned ? 'Owned' : 'R' + film.price.toFixed(0)) %>
                            <% if (film.accessExpiresAt) { %>
                                <span class="block text-[11px] font-normal text-[#a99a8b]">Until <%= film.accessExpiresAt.toLocaleDateString('en-ZA', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                            <% } %>
                        </span>
                        <span class="bg-[#fb6b10] group-hover:bg-[#ef420f] text-[#f4ece3] px-6 py-2.5 rounded-xl font-bold text-sm shadow-md shadow-[#fb6b10]/20 transition-all">
                            <%= film.owned ? 'Watch' : 'Buy R' + film.price.toFixed(0) %>
                        </span>
                    </div>
                </div>
            </a>
        <% }) %>
    </div>

    <%- include('partials/footer') %>
</main>
<script>
    // Price and sort apply as soon as they change; the search box applies on Enter/Search.
    document.querySelectorAll('#film-filters select').forEach(sel =>
        sel.addEventListener('change', () => sel.form.submit()));
</script>
</body>
</html>
