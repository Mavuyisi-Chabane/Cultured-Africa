<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Cultured Africa — Home' }) %>
</head>
<body class="min-h-screen">
<%- include('partials/header') %>

<main class="max-w-7xl mx-auto px-6 py-8 relative">
    <div class="absolute inset-0 pattern-overlay pointer-events-none"></div>

    <div class="mb-8">
        <h1 class="text-2xl md:text-3xl font-bold text-[#f7efe6] mb-1">Welcome back, <%= currentUser.fullName %></h1>
        <p class="text-[#a99a8b] text-sm">Continue exploring the rich heritage of Cultured Africa.</p>
    </div>

    <div class="mb-10 overflow-x-auto">
        <div class="flex items-center gap-3 min-w-max pb-2">
            <a href="/?culture=All" class="px-6 py-2 rounded-full text-sm font-bold shadow-md transition-all <%= activeCulture === 'All' ? 'bg-[#fb6b10] text-[#f4ece3]' : 'border border-[#38281f] bg-[#1e1613] text-[#f7efe6] hover:border-[#fcaa13]' %>">All</a>
            <% cultures.forEach(culture => { %>
                <a href="/?culture=<%= encodeURIComponent(culture) %>" class="px-6 py-2 rounded-full text-sm font-medium shadow-md transition-all <%= activeCulture === culture ? 'bg-[#fb6b10] text-[#f4ece3] font-bold' : 'border border-[#38281f] bg-[#1e1613] text-[#f7efe6] hover:border-[#fcaa13]' %>"><%= culture %></a>
            <% }) %>
        </div>
    </div>

    <div id="film-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% if (films.length === 0) { %>
            <p class="text-[#a99a8b] col-span-full text-center py-10">No films found for this culture yet.</p>
        <% } %>
        <% films.forEach(film => { %>
            <a href="/film/<%= film.id %>" class="bg-[#1e1613] rounded-[16px] shadow-sm border border-[#38281f] overflow-hidden group hover:shadow-xl transition-all duration-300">
                <div class="h-56 overflow-hidden relative">
                    <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="<%= film.thumbnailUrl %>" alt="<%= film.title %>" />
                    <% if (film.price > 0) { %>
                        <div class="absolute top-4 right-4 bg-[#1e1613]/90 backdrop-blur px-2 py-1 rounded text-[10px] font-bold text-[#f7efe6] uppercase tracking-widest">Premium</div>
                    <% } %>
                </div>
                <div class="p-6">
                    <h3 class="text-xl font-bold text-[#f7efe6] mb-1"><%= film.title %></h3>
                    <p class="text-[#a99a8b] text-xs font-medium mb-4 italic"><%= film.culture %> Heritage · <%= film.genre %></p>

                    <div class="flex items-center gap-1 mb-4 text-[#fcaa13]">
                        <% const full = Math.floor(film.rating); const half = film.rating - full >= 0.5; %>
                        <% for (let i = 0; i < 5; i++) { %>
                            <% if (i < full) { %>
                                <i class="fa-solid fa-star text-xs"></i>
                            <% } else if (i === full && half) { %>
                                <i class="fa-solid fa-star-half-stroke text-xs"></i>
                            <% } else { %>
                                <i class="fa-regular fa-star text-xs"></i>
                            <% } %>
                        <% } %>
                        <span class="text-[#a99a8b] text-xs ml-1 font-normal">(<%= film.rating.toFixed(1) %>)</span>
                    </div>

                    <div class="flex items-center justify-between mt-6 pt-4 border-t border-[#38281f]">
                        <span class="<%= film.price > 0 && !film.owned ? 'text-[#9db183]' : 'text-[#fcaa13]' %> font-bold text-lg">
                            <%= film.price === 0 ? 'Free' : (film.owned ? 'Owned' : 'R' + film.price.toFixed(0)) %>
                        </span>
                        <span class="bg-[#fb6b10] group-hover:bg-[#ef420f] text-[#f4ece3] px-6 py-2.5 rounded-xl font-bold text-sm shadow-md shadow-[#fb6b10]/20 transition-all">
                            <%= film.owned ? 'Watch' : 'Buy R' + film.price.toFixed(0) %>
                        </span>
                    </div>
                </div>
            </a>
        <% }) %>
    </div>

    <%- include('partials/footer') %>
</main>
</body>
</html>
