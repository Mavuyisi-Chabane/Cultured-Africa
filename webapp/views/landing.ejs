    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        // Brand identity preserved: gold accent + deep charcoal-navy for contrast.
                        // Surfaces rebuilt as a warm neutral ladder (cream/alabaster/sand) so
                        // white never sits directly against gold or deep navy.
                        primary: '#f5f0e8',   // base page surface (warm cream)
                        surface: '#ece5da',    // elevated card / section (warm alabaster)
                        sand: '#e3d9cb',       // secondary tile (soft sand)
                        ink: '#1a1a2e',        // primary text / dark fills (charcoal-navy)
                        muted: '#6b6558',      // secondary text
                        border: '#d4cbb8',     // hairline borders on light surfaces
                        borderdark: '#323254', // hairline borders on dark surfaces
                        accent: '#c9a84c',     // brand gold accent (interactive only)
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Cormorant Garamond', 'serif'],
                    },
                    keyframes: {
                        scroll: {
                            '0%': { transform: 'translateX(0)' },
                            '100%': { transform: 'translateX(-50%)' },
                        },
                        floaty: {
                            '0%,100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-10px)' },
                        },
                    },
                    animation: {
                        scroll: 'scroll 30s linear infinite',
                        floaty: 'floaty 6s ease-in-out infinite',
                    },
                },
            },
        };
