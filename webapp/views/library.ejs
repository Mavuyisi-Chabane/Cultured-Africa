<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Cultured Africa — My Library' }) %>
</head>
<body class="min-h-screen">
<%- include('partials/header') %>

<main class="max-w-7xl mx-auto px-6 py-8 relative">
    <div class="absolute inset-0 pattern-overlay pointer-events-none"></div>

    <div class="mb-8">
        <h1 class="text-2xl md:text-3xl font-bold text-[#f7efe6] mb-1">My Library</h1>
        <p class="text-[#a99a8b] text-sm">Films you own — purchased titles and free content, ready to watch anytime.</p>
    </div>

    <% if (films.length === 0) { %>
        <div class="bg-[#1e1613] rounded-[24px] border border-[#38281f] p-12 text-center">
            <i class="fa-solid fa-clapperboard text-3xl text-[#fcaa13] mb-4"></i>
            <p class="text-[#f7efe6] font-medium mb-2">Your library is empty.</p>
            <p class="text-[#a99a8b] text-sm mb-6">Purchase a film or watch something free to add it here.</p>
            <a href="/" class="inline-block bg-[#fb6b10] hover:bg-[#ef420f] text-[#f4ece3] px-6 py-3 rounded-xl font-bold text-sm shadow-md shadow-[#fb6b10]/20 transition-all">Browse Films</a>
        </div>
    <% } else { %>
        <div id="library-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% films.forEach(film => { %>
                <a href="/film/<%= film.id %>" class="bg-[#1e1613] rounded-[16px] shadow-sm border border-[#38281f] overflow-hidden group hover:shadow-xl transition-all duration-300">
                    <div class="h-56 overflow-hidden relative">
                        <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="<%= film.thumbnailUrl %>" alt="<%= film.title %>" />
                        <div class="absolute top-4 right-4 bg-[#1e1613]/90 backdrop-blur px-2 py-1 rounded text-[10px] font-bold text-[#f7efe6] uppercase tracking-widest">
                            <%= film.purchasedAt ? 'Purchased' : 'Free' %>
                        </div>
                    </div>
                    <div class="p-6">
                        <h3 class="text-xl font-bold text-[#f7efe6] mb-1"><%= film.title %></h3>
                        <p class="text-[#a99a8b] text-xs font-medium mb-4 italic"><%= film.culture %> Heritage · <%= film.genre %></p>

                        <div class="flex items-center gap-1 mb-4 text-[#fcaa13]">
                            <% const full = Math.floor(film.rating); const half = film.rating - full >= 0.5; %>
                            <% for (let i = 0; i < 5; i++) { %>
                                <% if (i < full) { %>
                                    <i class="fa-solid fa-star text-xs"></i>
                                <% } else if (i === full && half) { %>
                                    <i class="fa-solid fa-star-half-stroke text-xs"></i>
                                <% } else { %>
                                    <i class="fa-regular fa-star text-xs"></i>
                                <% } %>
                            <% } %>
                            <span class="text-[#a99a8b] text-xs ml-1 font-normal">(<%= film.rating.toFixed(1) %>)</span>
                        </div>

                        <div class="flex items-center justify-between mt-6 pt-4 border-t border-[#38281f]">
                            <span class="text-[#a99a8b] text-xs">
                                <% if (film.purchasedAt) { %>
                                    Bought <%= film.purchasedAt.toLocaleDateString() %>
                                <% } else { %>
                                    Free to watch
                                <% } %>
                            </span>
                            <span class="bg-[#fb6b10] group-hover:bg-[#ef420f] text-[#f4ece3] px-6 py-2.5 rounded-xl font-bold text-sm shadow-md shadow-[#fb6b10]/20 transition-all">Watch</span>
                        </div>
                    </div>
                </a>
            <% }) %>
        </div>
    <% } %>

    <%- include('partials/footer') %>
</main>
</body>
</html>
