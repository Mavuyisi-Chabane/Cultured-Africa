<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Cultured Africa — ' + title }) %>
</head>
<body class="min-h-screen">
<%- include('partials/simple-header') %>

<main class="min-h-[70vh] flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-[480px] text-center">
        <div class="w-16 h-16 rounded-full mx-auto mb-5 flex items-center justify-center <%= ok ? 'bg-[#9db183]/15 text-[#9db183]' : 'bg-[#b62319]/15 text-[#ef420f]' %>">
            <i class="fa-solid <%= ok ? 'fa-envelope-circle-check' : 'fa-link-slash' %> text-2xl"></i>
        </div>
        <h1 class="display-font text-3xl font-bold text-[#f7efe6] mb-3"><%= title %></h1>
        <p class="text-[#a99a8b] leading-relaxed mb-8"><%= message %></p>
        <a href="/films" class="inline-block px-6 py-3 rounded-xl bg-[#fb6b10] hover:bg-[#ef420f] text-[#f4ece3] font-bold text-sm">Browse our films</a>
    </div>
</main>
</body>
</html>
