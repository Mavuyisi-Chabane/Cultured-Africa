<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[200] focus:bg-[#fcaa13] focus:text-[#140d0a] focus:font-bold focus:px-4 focus:py-2 focus:rounded-lg">Skip to main content</a>
<%
  const reportKeys = ['reports', 'analytics', 'engagement'];
  const navLink = (href, label, key) => {
    const keys = Array.isArray(key) ? key : [key];
    const isActive = typeof active !== 'undefined' && keys.includes(active);
    const cls = isActive
      ? 'text-[#fcaa13] text-sm font-bold border-b-2 border-[#fcaa13] pb-1'
      : 'text-[#f4ece3]/70 hover:text-[#f4ece3] transition-colors text-sm font-medium';
    return `<a href="${href}" class="${cls}">${label}</a>`;
  };
  const initials = currentAdmin.name.trim().split(/\s+/).map(w => w[0]).slice(0, 2).join('').toUpperCase();
%>
<nav id="header" class="pdf-hide bg-[#0f0a08] px-4 sm:px-6 py-4 flex items-center justify-between gap-3 sticky top-0 z-50 shadow-lg">
    <div class="flex items-center gap-8">
        <div class="flex items-center gap-2">
            <a href="/admin/dashboard" class="display-font text-xl sm:text-2xl whitespace-nowrap font-bold text-[#fcaa13] tracking-tight flex items-center gap-2"><img src="/images/brand/sun.png" alt="" class="h-8 w-8">Cultured Africa</a>
            <span class="hidden sm:inline text-[#f4ece3]/70 text-xs font-bold uppercase tracking-widest ml-2 border-l border-[#38281f]/20 pl-3">Admin Portal</span>
        </div>
        <div class="hidden lg:flex items-center gap-5">
            <%- navLink('/admin/dashboard', 'Dashboard', 'dashboard') %>
            <%- navLink('/admin/activity', 'Recent Activity', 'activity') %>
            <%- navLink('/admin/films', 'Manage Films', 'films') %>
            <%- navLink('/admin/cultures', 'Cultures', 'cultures') %>
            <%- navLink('/admin/customers', 'Customers', 'customers') %>
            <%- navLink('/admin/feedback', 'Feedback', 'feedback') %>
            <%- navLink('/admin/reports', 'Reports', reportKeys) %>
            <% if (currentAdmin.role === 'super_admin') { %>
                <%- navLink('/admin/manage-admins', 'Manage Admins', 'manage-admins') %>
            <% } %>
        </div>
    </div>
    <div class="flex items-center gap-4">
        <div class="flex items-center gap-3 sm:pr-4 sm:border-r border-[#38281f]/10">
            <div class="text-right hidden sm:block">
                <p class="text-[#f4ece3] text-xs font-bold"><%= currentAdmin.name %></p>
                <p class="text-[#f4ece3]/70 text-[10px] uppercase tracking-tighter"><%= currentAdmin.role === 'super_admin' ? 'Super Admin' : 'Admin' %></p>
            </div>
            <div class="w-9 h-9 rounded-full border-2 border-[#fcaa13] bg-[#271c17]/10 flex items-center justify-center text-[#fcaa13] text-xs font-bold">
                <%= initials %>
            </div>
        </div>
        <button type="button" id="admin-menu-btn" class="lg:hidden w-10 h-10 rounded-full bg-[#1e1613] text-[#f4ece3] flex items-center justify-center" aria-controls="admin-menu" aria-expanded="false" aria-label="Menu">
            <i class="fa-solid fa-bars"></i>
        </button>
        <form action="/admin/logout" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" aria-label="Log out" title="Log out" class="text-[#f4ece3]/80 hover:text-[#fcaa13] transition-colors text-sm font-medium">
                <i class="fa-solid fa-right-from-bracket"></i>
            </button>
        </form>
    </div>
</nav>
<div id="admin-menu" class="pdf-hide lg:hidden sticky top-[72px] z-40 bg-[#0f0a08] border-t border-b border-[#38281f] px-6 py-3 grid grid-cols-2 sm:grid-cols-3 gap-1" hidden>
    <% [['/admin/dashboard', 'Dashboard', 'fa-gauge'], ['/admin/activity', 'Recent Activity', 'fa-clock-rotate-left'], ['/admin/films', 'Manage Films', 'fa-film'], ['/admin/cultures', 'Cultures', 'fa-earth-africa'], ['/admin/customers', 'Customers', 'fa-users'], ['/admin/feedback', 'Feedback', 'fa-comments'], ['/admin/reports', 'Reports', 'fa-chart-line']].concat(currentAdmin.role === 'super_admin' ? [['/admin/manage-admins', 'Manage Admins', 'fa-user-shield']] : []).forEach(([href, label, icon]) => { %>
        <a href="<%= href %>" class="flex items-center gap-3 px-3 py-3 rounded-xl text-sm text-[#f4ece3] hover:bg-[#1e1613]"><i class="fa-solid <%= icon %> w-5 text-center text-[#fcaa13]"></i><%= label %></a>
    <% }) %>
</div>
<script>
    (function () {
        var btn = document.getElementById('admin-menu-btn');
        var menu = document.getElementById('admin-menu');
        btn.addEventListener('click', function () {
            menu.hidden = !menu.hidden;
            btn.setAttribute('aria-expanded', String(!menu.hidden));
        });
    })();
</script>
