<script>
    (function () {
        var passwordInput = document.getElementById('password');
        var strengthLabel = document.getElementById('password-strength-label');
        var strengthBar = document.getElementById('password-strength-bar');
        if (!passwordInput || !strengthLabel || !strengthBar) return;

        var requirements = [
            { key: 'length', test: function (v) { return v.length >= 8; } },
            { key: 'upper', test: function (v) { return /[A-Z]/.test(v); } },
            { key: 'lower', test: function (v) { return /[a-z]/.test(v); } },
            { key: 'number', test: function (v) { return /[0-9]/.test(v); } },
            { key: 'special', test: function (v) { return /[!@#$%^&*(),.?":{}|<>_\-+=~`[\]\\/;']/.test(v); } }
        ];

        var STRENGTH_COLORS = {
            weak: { bar: 'bg-red-500', text: 'text-red-500' },
            medium: { bar: 'bg-amber-500', text: 'text-amber-500' },
            strong: { bar: 'bg-green-600', text: 'text-green-600' }
        };
        var ALL_BAR_CLASSES = ['bg-red-500', 'bg-amber-500', 'bg-green-600'];
        var ALL_TEXT_CLASSES = ['text-red-500', 'text-amber-500', 'text-green-600'];

        function updatePasswordUI() {
            var value = passwordInput.value;
            var metCount = 0;

            requirements.forEach(function (req) {
                var met = req.test(value);
                if (met) metCount++;

                var row = document.querySelector('[data-req="' + req.key + '"]');
                var icon = row.querySelector('i');

                row.classList.toggle('text-red-500', !met);
                row.classList.toggle('text-green-600', met);
                icon.classList.toggle('fa-circle-xmark', !met);
                icon.classList.toggle('fa-circle-check', met);
            });

            var strength = metCount <= 2 ? 'weak' : (metCount <= 4 ? 'medium' : 'strong');
            var colors = STRENGTH_COLORS[strength];

            strengthBar.style.width = (metCount / requirements.length) * 100 + '%';
            ALL_BAR_CLASSES.forEach(function (c) { strengthBar.classList.remove(c); });
            strengthBar.classList.add(colors.bar);

            ALL_TEXT_CLASSES.forEach(function (c) { strengthLabel.classList.remove(c); });
            strengthLabel.classList.add(colors.text);
            strengthLabel.textContent = strength.charAt(0).toUpperCase() + strength.slice(1);
        }

        passwordInput.addEventListener('input', updatePasswordUI);
        updatePasswordUI();
    })();

    (function () {
        var passwordInput = document.getElementById('password');
        var confirmInput = document.getElementById('confirm');
        var errorEl = document.getElementById('confirm-password-error');
        if (!passwordInput || !confirmInput || !errorEl) return;

        function checkMatch() {
            if (!confirmInput.value) {
                errorEl.classList.add('hidden');
                return;
            }
            var matches = confirmInput.value === passwordInput.value;
            errorEl.classList.toggle('hidden', matches);
        }

        passwordInput.addEventListener('input', checkMatch);
        confirmInput.addEventListener('input', checkMatch);
    })();
</script>
