<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/png" href="/images/brand/sun.png">
<title>Receipt <%= receipt.number %> — Cultured Africa</title>
<style>
    /* A light, paper-like page on purpose: receipts get printed and saved as PDFs. */
    :root { --ink: #1f1a16; --muted: #645a50; --line: #e6ddd2; --accent: #9a5b00; --page: #f3eee7; }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--page); color: var(--ink); font: 15px/1.55 "Segoe UI", "Helvetica Neue", Arial, sans-serif; padding: 32px 16px; }
    .actions { max-width: 720px; margin: 0 auto 16px; display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between; }
    .actions a, .actions button { font: 600 14px/1 inherit; font-family: inherit; padding: 11px 16px; border-radius: 8px; text-decoration: none; cursor: pointer; }
    .actions a { color: var(--ink); border: 1px solid var(--line); background: #fff; }
    .actions button { color: #fff; background: #b35f00; border: 0; }
    .sheet { max-width: 720px; margin: 0 auto; background: #fff; border-radius: 12px; box-shadow: 0 2px 18px rgba(0,0,0,.07); padding: 40px; }
    header { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; align-items: flex-start; border-bottom: 2px solid var(--ink); padding-bottom: 20px; margin-bottom: 24px; }
    .brand { display: flex; align-items: center; gap: 10px; }
    .brand img { width: 44px; height: 44px; }
    .brand strong { font: 700 20px Georgia, "Times New Roman", serif; letter-spacing: .06em; text-transform: uppercase; display: block; }
    .brand span { font-size: 12px; color: var(--muted); }
    .doc-title { text-align: right; }
    .doc-title h1 { margin: 0; font: 700 26px Georgia, "Times New Roman", serif; }
    .doc-title p { margin: 2px 0 0; color: var(--muted); font-size: 13px; font-variant-numeric: tabular-nums; }
    .paid { display: inline-block; margin-top: 8px; padding: 4px 10px; border-radius: 999px; background: #e2f2e7; color: #1d6b3a; font-weight: 700; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
    .parties { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 24px; font-size: 14px; }
    .parties h2 { margin: 0 0 4px; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
    .parties p { margin: 0; }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th { text-align: left; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--line); padding: 8px 0; }
    th:last-child, td:last-child { text-align: right; }
    td { padding: 12px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
    td small { display: block; color: var(--muted); font-size: 12.5px; margin-top: 2px; }
    .totals { margin-top: 12px; margin-left: auto; width: min(100%, 300px); font-size: 14px; }
    .totals div { display: flex; justify-content: space-between; padding: 4px 0; font-variant-numeric: tabular-nums; }
    .totals .grand { border-top: 2px solid var(--ink); margin-top: 6px; padding-top: 8px; font-size: 18px; font-weight: 700; }
    dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 20px; margin: 28px 0 0; font-size: 14px; }
    dt { color: var(--muted); }
    dd { margin: 0; font-variant-numeric: tabular-nums; word-break: break-word; }
    footer { margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--muted); font-size: 12.5px; }
    @media (max-width: 520px) { .sheet { padding: 24px; } .doc-title { text-align: left; } }
    @media print {
        body { background: #fff; padding: 0; }
        .actions { display: none; }
        .sheet { box-shadow: none; border-radius: 0; padding: 0; max-width: none; }
    }
</style>
</head>
<body>
    <div class="actions">
        <a href="/account">← Back to my account</a>
        <button type="button" id="printReceipt">Print / Save as PDF</button>
    </div>

    <main class="sheet">
        <header>
            <div class="brand">
                <img src="/images/brand/sun.png" alt="">
                <div><strong><%= receipt.business.BUSINESS_NAME %></strong><span>Cinematic stories of South African heritage</span></div>
            </div>
            <div class="doc-title">
                <h1>Receipt</h1>
                <p><%= receipt.number %></p>
                <p><%= receipt.purchasedAtLabel %></p>
                <span class="paid">Paid</span>
            </div>
        </header>

        <section class="parties">
            <div>
                <h2>From</h2>
                <p><strong><%= receipt.business.BUSINESS_NAME %></strong></p>
                <% if (receipt.business.BUSINESS_REG_NO) { %><p>Reg. no. <%= receipt.business.BUSINESS_REG_NO %></p><% } %>
                <% if (receipt.business.BUSINESS_VAT_NO) { %><p>VAT no. <%= receipt.business.BUSINESS_VAT_NO %></p><% } %>
                <p><%= receipt.business.BUSINESS_ADDRESS %></p>
                <p><%= receipt.business.BUSINESS_EMAIL %></p>
            </div>
            <div>
                <h2>Billed to</h2>
                <p><strong><%= receipt.customer.name %></strong></p>
                <p><%= receipt.customer.email %></p>
            </div>
        </section>

        <table>
            <thead><tr><th>Description</th><th>Amount</th></tr></thead>
            <tbody>
                <tr>
                    <td>
                        <strong><%= receipt.film.title %></strong>
                        <small><%= receipt.film.culture %> · Age rating <%= receipt.film.rating %></small>
                        <small>Streaming access: unlimited viewing for <%= receipt.accessMonths %> months, until <%= receipt.accessUntilLabel %></small>
                    </td>
                    <td><%= receipt.totalLabel %></td>
                </tr>
            </tbody>
        </table>

        <div class="totals">
            <% if (receipt.vatLabel) { %>
                <div><span>Includes VAT (15%)</span><span><%= receipt.vatLabel %></span></div>
            <% } %>
            <div class="grand"><span>Total paid (<%= receipt.currency %>)</span><span><%= receipt.totalLabel %></span></div>
        </div>

        <dl>
            <dt>Paid with</dt><dd><%= receipt.paymentMethod %></dd>
            <dt>Payment reference</dt><dd><%= receipt.reference || 'Not available' %></dd>
            <dt>Processed by</dt><dd>Paystack</dd>
        </dl>

        <footer>
            Thank you for supporting South African storytelling. Keep this receipt as proof of purchase.
            For questions about this purchase, contact <%= receipt.business.BUSINESS_EMAIL %> and quote <%= receipt.number %>.
        </footer>
    </main>

<script>
    document.getElementById('printReceipt').addEventListener('click', function () { window.print(); });
</script>
</body>
</html>
