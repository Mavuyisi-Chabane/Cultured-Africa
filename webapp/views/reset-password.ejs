<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Cultured Africa — Reset Password' }) %>
</head>
<body class="min-h-screen flex items-center justify-center p-4 py-10 pattern-bg relative overflow-x-hidden">
    <div class="absolute -top-24 -left-24 w-96 h-96 opacity-10 pointer-events-none">
        <img class="w-full h-full object-contain" src="https://storage.googleapis.com/uxpilot-auth.appspot.com/gen_ca850ca978_d4ec892f98137ca1.png" alt="">
    </div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 opacity-10 pointer-events-none">
        <img class="w-full h-full object-contain" src="https://storage.googleapis.com/uxpilot-auth.appspot.com/gen_a0803f0285_0b097c705f62f8d3.png" alt="">
    </div>

    <div class="w-full max-w-[450px] bg-[#1e1613] rounded-[16px] shadow-xl p-8 md:p-10 z-10">
        <% if (status === 'invalid' || status === 'expired') { %>
            <div class="text-center">
                <div class="w-16 h-16 rounded-full bg-[#b62319]/15 flex items-center justify-center text-[#ef420f] mx-auto mb-6">
                    <i class="fa-solid <%= status === 'expired' ? 'fa-clock' : 'fa-triangle-exclamation' %> text-2xl"></i>
                </div>
                <h1 class="display-font text-2xl font-bold text-[#f7efe6] mb-3">
                    <%= status === 'expired' ? 'Reset Link Expired' : 'Invalid Reset Link' %>
                </h1>
                <p class="text-[#a99a8b] text-sm leading-relaxed mb-8">
                    <% if (status === 'expired') { %>
                        Password reset links are valid for only 30 minutes, and this one has passed that window. Request a new one below.
                    <% } else { %>
                        This link is invalid, malformed, or has already been used. Request a new one below.
                    <% } %>
                </p>
                <a href="/forgot-password" class="inline-block w-full bg-[#fb6b10] hover:bg-[#ef420f] text-[#f4ece3] font-bold py-3 px-8 rounded-xl shadow-lg shadow-[#fb6b10]/20 transition-all mb-4">
                    Request New Reset Link
                </a>
                <a href="/login" class="text-[#a99a8b] text-sm hover:underline">Back to Login</a>
            </div>

        <% } else if (status === 'success') { %>
            <div class="text-center">
                <div class="w-16 h-16 rounded-full bg-[#271c17] flex items-center justify-center text-[#9db183] mx-auto mb-6">
                    <i class="fa-solid fa-circle-check text-2xl"></i>
                </div>
                <h1 class="display-font text-2xl font-bold text-[#f7efe6] mb-3">Password Reset Successful!</h1>
                <p class="text-[#a99a8b] text-sm leading-relaxed mb-8">
                    Your password has been changed. For your security, you've been logged out everywhere and will need to log in again.
                </p>
                <a href="/login" class="inline-block bg-[#fb6b10] hover:bg-[#ef420f] text-[#f4ece3] font-bold py-3 px-8 rounded-xl shadow-lg shadow-[#fb6b10]/20 transition-all">
                    Continue to Login
                </a>
            </div>

        <% } else { %>
            <div class="text-center mb-10">
                <h1 class="display-font text-3xl font-bold text-[#fcaa13] mb-2">Reset Your Password</h1>
                <p class="text-[#a99a8b] text-sm">Choose a new password for your account.</p>
            </div>

            <% if (error) { %>
                <div class="mb-6 px-4 py-3 rounded-xl bg-[#b62319]/15 text-[#ef420f] text-sm font-medium"><%= error %></div>
            <% } %>

            <form id="reset-password-form" class="space-y-6" method="POST" action="/reset-password">
                <input type="hidden" name="token" value="<%= token %>">

                <div id="field-password">
                    <label class="block text-xs font-bold uppercase tracking-wider text-[#f7efe6] mb-2" for="password">New Password</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-[#a99a8b]">
                            <i class="fa-solid fa-lock text-sm"></i>
                        </span>
                        <input type="password" id="password" name="password" placeholder="••••••••" required autocomplete="new-password"
                            class="w-full pl-11 pr-11 py-3 border border-[#38281f] rounded-xl focus:ring-2 focus:ring-[#fcaa13] focus:border-transparent outline-none transition-all text-[#f4ece3] bg-[#271c17]/50">
                        <button type="button" class="absolute inset-y-0 right-0 pr-4 flex items-center text-[#a99a8b] hover:text-[#fcaa13] transition-colors" data-toggle-password="password" aria-label="Show password">
                            <i class="fa-solid fa-eye text-sm"></i>
                        </button>
                    </div>

                    <div class="mt-3 space-y-1.5">
                        <p data-req="length" class="flex items-center gap-2 text-xs text-[#ef420f] transition-colors">
                            <i class="fa-solid fa-circle-xmark text-[10px]"></i> At least 8 characters
                        </p>
                        <p data-req="upper" class="flex items-center gap-2 text-xs text-[#ef420f] transition-colors">
                            <i class="fa-solid fa-circle-xmark text-[10px]"></i> At least one uppercase letter (A-Z)
                        </p>
                        <p data-req="lower" class="flex items-center gap-2 text-xs text-[#ef420f] transition-colors">
                            <i class="fa-solid fa-circle-xmark text-[10px]"></i> At least one lowercase letter (a-z)
                        </p>
                        <p data-req="number" class="flex items-center gap-2 text-xs text-[#ef420f] transition-colors">
                            <i class="fa-solid fa-circle-xmark text-[10px]"></i> At least one number (0-9)
                        </p>
                        <p data-req="special" class="flex items-center gap-2 text-xs text-[#ef420f] transition-colors">
                            <i class="fa-solid fa-circle-xmark text-[10px]"></i> At least one special character (e.g. ! @ # $ %)
                        </p>
                    </div>

                    <div class="mt-3">
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-[10px] font-bold uppercase tracking-widest text-[#a99a8b]">Password Strength</span>
                            <span id="password-strength-label" class="text-[10px] font-bold uppercase tracking-widest text-[#ef420f]">Weak</span>
                        </div>
                        <div class="w-full h-1.5 bg-[#271c17] rounded-full overflow-hidden">
                            <div id="password-strength-bar" class="h-full bg-[#b62319] transition-all duration-300 ease-out" style="width: 0%"></div>
                        </div>
                    </div>
                </div>

                <div id="field-confirm">
                    <label class="block text-xs font-bold uppercase tracking-wider text-[#f7efe6] mb-2" for="confirm">Confirm New Password</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-[#a99a8b]">
                            <i class="fa-solid fa-shield-check text-sm"></i>
                        </span>
                        <input type="password" id="confirm" name="confirm" placeholder="••••••••" required autocomplete="new-password"
                            class="w-full pl-11 pr-11 py-3 border border-[#38281f] rounded-xl focus:ring-2 focus:ring-[#fcaa13] focus:border-transparent outline-none transition-all text-[#f4ece3] bg-[#271c17]/50">
                        <button type="button" class="absolute inset-y-0 right-0 pr-4 flex items-center text-[#a99a8b] hover:text-[#fcaa13] transition-colors" data-toggle-password="confirm" aria-label="Show password">
                            <i class="fa-solid fa-eye text-sm"></i>
                        </button>
                    </div>
                    <p id="confirm-password-error" class="mt-2 text-xs text-[#ef420f] hidden">
                        <i class="fa-solid fa-circle-exclamation"></i> Passwords do not match.
                    </p>
                </div>

                <button id="reset-password-submit" type="submit"
                    class="w-full bg-[#fb6b10] hover:bg-[#ef420f] text-[#f4ece3] font-bold py-4 rounded-xl shadow-lg shadow-[#fb6b10]/20 transform transition-all active:scale-[0.98] flex items-center justify-center gap-2 disabled:opacity-70">
                    <span id="reset-password-submit-label">Reset Password</span>
                </button>
            </form>

            <div class="mt-8 pt-8 border-t border-[#38281f] text-center">
                <p class="text-[#a99a8b] text-sm">
                    <a href="/login" class="text-[#fcaa13] font-bold hover:underline">Back to Login</a>
                </p>
            </div>
        <% } %>
    </div>

    <div class="absolute inset-0 z-0 opacity-20 pointer-events-none mix-blend-multiply">
        <img class="w-full h-full object-cover" src="https://storage.googleapis.com/uxpilot-auth.appspot.com/gen_5a943a1ed8_2798cfb2407b212d.png" alt="">
    </div>

    <% if (status === 'form') { %>
        <%- include('partials/password-requirements') %>
        <%- include('partials/password-toggle') %>
        <script>
            (function () {
                var form = document.getElementById('reset-password-form');
                var submitBtn = document.getElementById('reset-password-submit');
                var label = document.getElementById('reset-password-submit-label');
                if (!form || !submitBtn || !label) return;

                form.addEventListener('submit', function () {
                    submitBtn.disabled = true;
                    label.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Resetting...';
                });
            })();
        </script>
    <% } %>
</body>
</html>
